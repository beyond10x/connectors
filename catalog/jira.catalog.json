{
  "$schema": "https://github.com/beyond10x/b10x/blob/main/foundation/connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Atlassian API token; the user half is the account email that minted it",
      "env": [
        "JIRA_API_TOKEN"
      ],
      "name": "jira.api_token",
      "scheme": {
        "kind": "basic"
      },
      "subject": "unstated",
      "user_env": [
        "JIRA_USER"
      ]
    },
    {
      "description": "Atlassian OAuth 2.0 access token granted by a signed-in user and bounded by that user's Jira permissions",
      "name": "jira.user_oauth",
      "oauth2": {
        "authorize_path": "/authorize",
        "endpoint": "login",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "scopes": [
          "offline_access",
          "read:jira-work",
          "read:me",
          "write:jira-work"
        ],
        "token_path": "/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user"
    },
    {
      "description": "Atlassian service-account OAuth 2.0 access token for the tenant-shared read-only issue projection",
      "name": "jira.service_oauth",
      "oauth2": {
        "authorize_path": "/authorize",
        "endpoint": "login",
        "grants": [
          "client_credentials"
        ],
        "scopes": [
          "read:jira-work"
        ],
        "token_path": "/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "app"
    },
    {
      "description": "Scoped Atlassian service-account API token for the tenant-shared read-only issue projection",
      "env": [
        "JIRA_SERVICE_API_TOKEN"
      ],
      "name": "jira.service_api_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "app"
    }
  ],
  "authority": "com.atlassian.jira",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.site",
      "docs_url": "https://support.atlassian.com/jira-software-cloud/docs/what-is-a-jira-site/",
      "example": "acme",
      "format": "subdomain",
      "help": "The part of your Jira URL before `.atlassian.net` — if you sign in at `acme.atlassian.net`, this is `acme`",
      "label": "Atlassian site name",
      "level": "connection",
      "name": "site",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "username.jira.api_token",
      "example": "you@acme.com",
      "format": "email",
      "help": "The email of the account that minted the API token. It travels as the username half of the request",
      "label": "Atlassian account email",
      "level": "connection",
      "name": "email",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.jira.api_token",
      "docs_url": "https://id.atlassian.com/manage-profile/security/api-tokens",
      "format": "token",
      "help": "Create one at id.atlassian.com under Security → API tokens. Atlassian shows it once",
      "label": "API token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.client_id",
      "docs_url": "https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/",
      "format": "text",
      "help": "The client ID of the Atlassian OAuth 2.0 (3LO) application registered for this deployment. Supplied once by the deployment operator, not by the user authorizing a Jira Connection",
      "label": "Atlassian OAuth application client ID",
      "level": "operator",
      "name": "oauth_client_id",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.redirect_uri",
      "docs_url": "https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/",
      "example": "https://connectors.example/api/oauth/callback",
      "format": "url",
      "help": "The callback URL served by this deployment and registered on the Atlassian OAuth application",
      "label": "Atlassian OAuth callback URL",
      "level": "operator",
      "name": "oauth_redirect_uri",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.client_secret",
      "docs_url": "https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/",
      "format": "token",
      "help": "The client secret issued for the Atlassian OAuth application. Supplied once by the deployment operator and never exposed to the user authorizing a Jira Connection",
      "label": "Atlassian OAuth application client secret",
      "level": "operator",
      "name": "oauth_client_secret",
      "required": false,
      "secret": true,
      "service": "default"
    }
  ],
