          "type": "object"
        }
      },
      "credential_requirement": "no-credential-required",
      "description": "List the tables and views of one schema on the MySQL server this Connection resolves, from INFORMATION_SCHEMA.TABLES (https://dev.mysql.com/doc/refman/8.4/en/information-schema-tables-table.html)",
      "direction": "read",
      "effects": [
        "read",
        "network"
      ],
      "expose": true,
