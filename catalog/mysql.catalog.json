{
  "$schema": "https://github.com/beyond10x/b10x/blob/main/foundation/connectors/catalog/connector-document.schema.json",
  "authority": "com.mysql.server",
  "connector": "mysql",
  "description": "Read a MySQL server through the closed built-in SQL driver: one bounded read-only query plus schema, table, and column inventory",
  "generator": "connectors 0.6.3",
  "operations": [
    {
      "auth": [],
      "contract": {
        "description": "Run one bounded read-only SQL statement (SELECT, SHOW, or DESCRIBE class, https://dev.mysql.com/doc/refman/8.4/en/select.html) against the MySQL database this Connection resolves. Anything else — INSERT, UPDATE, DDL, multiple statements — is refused before any connection is opened. Results stop at the row and byte caps and say so honestly",
        "input_schema": {
          "properties": {
            "max_rows": {
              "type": "number"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "statement"
          ],
          "type": "object"
        }
      },
      "credential_requirement": "no-credential-required",
      "description": "Run one bounded read-only SQL statement (SELECT, SHOW, or DESCRIBE class, https://dev.mysql.com/doc/refman/8.4/en/select.html) against the MySQL database this Connection resolves. Anything else — INSERT, UPDATE, DDL, multiple statements — is refused before any connection is opened. Results stop at the row and byte caps and say so honestly",
      "direction": "read",
      "effects": [
        "read",
        "network"
      ],
      "expose": true,
      "id": "mysql-query",
      "idempotency": "idempotent",
      "implementation_form": "built_in",
      "interaction_shape": "unary",
      "params": [
        {
          "description": "Exactly one read statement — SELECT, SHOW, or DESCRIBE class. A write statement, a second statement after a `;`, or anything that does not parse as a read is refused before any connection is opened",
          "name": "statement",
          "position": "body",
          "required": true,
          "schema": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "symbol": "statement"
        },
        {
          "description": "Optional row bound for this call. The effective bound is the smaller of this and the published 500-row cap: a caller can narrow the cap, never widen it",
          "name": "max_rows",
          "position": "body",
          "required": false,
          "schema": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "symbol": "max_rows"
        }
      ],
      "placement_requirement": "connectors_deployment",
      "protocol_driver": "sql_v1",
      "request": {},
      "required_capabilities": [
        "private_network"
      ],
      "response_schema": {
        "properties": {
          "bytes_returned": {
            "description": "Counted cell bytes across the returned rows",
            "type": "integer"
          },
          "columns": {
            "description": "Result column names, in wire order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "description": "Returned rows; every cell is the server's text rendering and null is an SQL NULL",
            "items": {
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "rows_returned": {
            "description": "How many rows were returned",
            "type": "integer"
          },
          "truncated": {
            "description": "Whether the result stopped before the statement's full result set",
            "type": "boolean"
          },
          "truncation_cause": {
            "description": "Why the page stopped early; absent when truncated is false",
            "enum": [
              "row_cap",
              "byte_cap"
            ],
            "type": "string"
          }
        },
        "required": [
          "columns",
          "rows",
          "rows_returned",
          "bytes_returned",
          "truncated"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [
        "read"
      ],
      "service": "default"
    },
    {
