    {
      "auth": [],
      "contract": {
        "description": "Describe one table's columns — name, data type, nullability, position — on the MySQL server this Connection resolves, from INFORMATION_SCHEMA.COLUMNS (https://dev.mysql.com/doc/refman/8.4/en/information-schema-columns-table.html). Structure only: no default expressions, comments, or row estimates",
        "input_schema": {
