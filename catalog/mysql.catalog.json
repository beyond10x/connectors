      "description": "List the schemas (databases) of the MySQL server this Connection resolves, from INFORMATION_SCHEMA.SCHEMATA (https://dev.mysql.com/doc/refman/8.4/en/information-schema-schemata-table.html), system schemas included",
      "direction": "read",
      "effects": [
        "read",
        "network"
      ],
      "expose": true,
      "id": "mysql-schemas-list",
      "idempotency": "idempotent",
      "implementation_form": "built_in",
      "interaction_shape": "unary",
      "placement_requirement": "connectors_deployment",
      "protocol_driver": "sql_v1",
      "request": {},
      "required_capabilities": [
