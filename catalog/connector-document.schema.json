{
  "$defs": {
    "auth": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "entry": {
          "enum": [
            "connect_session"
          ]
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hazard": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "oauth2": {
          "$ref": "#/$defs/oauth2"
        },
        "scheme": {
          "$ref": "#/$defs/scheme"
        },
        "subject": {
          "enum": [
            "unstated",
            "app",
            "user"
          ]
        },
        "token_endpoint_workarounds": {
          "items": {
            "$ref": "#/$defs/token_endpoint_workaround"
          },
          "type": "array"
        },
        "user_env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "user_suffix": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "scheme",
        "subject"
      ],
      "type": "object"
    },
    "auth_requirement": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "scopes": {
          "additionalProperties": {
            "items": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "type": "object"
        }
      },
      "required": [
        "credentials"
      ],
      "type": "object"
    },
    "auth_requirements": {
      "description": "Non-lossy auth alternatives with credential-local OR-of-AND granted-scope requirements.",
      "items": {
        "$ref": "#/$defs/auth_requirement"
      },
      "type": "array"
    },
    "body": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "const": "json"
            },
            "template": {
              "$ref": "#/$defs/body_template"
            }
          },
          "required": [
            "encoding",
            "template"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "const": "form"
            },
            "fields": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "value": {
                    "$ref": "#/$defs/value_template"
                  }
                },
                "required": [
                  "name",
                  "value",
                  "required"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "encoding",
            "fields"
          ],
          "type": "object"
        }
      ]
    },
    "body_template": {
      "description": "A JSON body: literals, nested objects and arrays, `$param` splices at caller leaves. Nothing else has a spelling.",
      "oneOf": [
        {
          "$ref": "#/$defs/param_splice"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/body_template"
          },
          "not": {
            "required": [
              "$param"
            ]
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/body_template"
          },
          "type": "array"
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "channel": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "session"
              ]
            }
          },
          "if": {
            "properties": {
              "transport": {
                "const": "session"
              }
            }
          },
          "then": {
            "required": [
              "session"
            ]
          }
        }
      ],
      "properties": {
        "auth": {
          "$ref": "#/$defs/requirements"
        },
        "auth_requirements": {
          "$ref": "#/$defs/auth_requirements"
        },
        "connect": {
          "type": "object"
        },
        "cursor": {
          "type": "string"
        },
        "delivery_id": {
          "$ref": "#/$defs/selector"
        },
        "description": {
          "type": "string"
        },
        "discriminator": {
          "$ref": "#/$defs/selector"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "interval": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "oip": {
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "payload_root": {
          "type": "boolean"
        },
        "reply": {
          "additionalProperties": false,
          "properties": {
            "bind": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "oip": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "required": [
            "operation"
          ],
          "type": "object"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/session_binding"
        },
        "setup": {
          "type": "object"
        },
        "subscription": {
          "type": "object"
        },
        "transport": {
          "enum": [
            "webhook",
            "socket",
            "poll",
            "session"
          ]
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "hmac": {
              "type": "object"
            },
            "kind": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "verified"
          ],
          "type": "object"
        }
      },
      "required": [
        "name",
        "service",
        "transport",
        "verification"
      ],
      "type": "object"
    },
    "config_field": {
      "additionalProperties": false,
      "properties": {
        "also_binds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "also_services": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "approval": {
          "enum": [
            "none",
            "operator"
          ]
        },
        "binds": {
          "minLength": 1,
          "type": "string"
        },
        "choices": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "default": {
          "type": "string"
        },
        "docs_url": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "format": {
          "enum": [
            "text",
            "subdomain",
            "hostname",
            "url",
            "origin",
            "email",
            "token"
          ]
        },
        "help": {
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "level": {
          "enum": [
            "operator",
            "connection"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "service",
        "label",
        "format",
        "required",
        "approval",
        "secret",
        "binds",
        "level"
      ],
      "type": "object"
    },
    "contract": {
      "additionalProperties": false,
      "description": "The model-facing contract projection (S-001; predecessor C-552): the error-envelope-extended description and the lowered, caller-typed input schema, computed at build time and stored so a consumer builds the caller's contract from document data alone.",
      "properties": {
        "description": {
          "type": "string"
        },
        "input_schema": {
          "$ref": "#/$defs/json_schema"
        }
      },
      "required": [
        "description",
        "input_schema"
      ],
      "type": "object"
    },
    "discovery": {
      "additionalProperties": false,
      "description": "A bounded observation source. It creates no Connection or authority; target Provider availability and route-adapter support are checked when a candidate is materialized.",
      "properties": {
        "driver": {
          "enum": [
            "grafana_datasource_v1"
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "mappings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "observed_type": {
                "pattern": "^[a-z0-9._-]+$",
                "type": "string"
              },
              "route_adapter": {
                "enum": [
                  "grafana_datasource_proxy_v1"
                ]
              },
              "target_provider": {
                "pattern": "^[a-z0-9._-]+$",
                "type": "string"
              }
            },
            "required": [
              "observed_type",
              "target_provider",
              "route_adapter"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "service",
        "operation",
        "driver",
        "mappings"
      ],
      "type": "object"
    },
    "error_envelope": {
      "additionalProperties": false,
      "properties": {
        "code_pointer": {
          "type": "string"
        },
        "message_pointer": {
          "type": "string"
        }
      },
      "required": [
        "message_pointer"
      ],
      "type": "object"
    },
    "event": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/requirements"
        },
        "auth_requirements": {
          "$ref": "#/$defs/auth_requirements"
        },
        "default": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "oip": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/json_schema"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "additionalProperties": {
            "$ref": "#/$defs/json_schema"
          },
          "type": "object"
        },
        "wire_value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "service",
        "default"
      ],
      "type": "object"
    },
    "http_request": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/body"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/value_template"
          },
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "query": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/value_template"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "url": {
          "pattern": "^\\{base\\}/",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url"
      ],
      "type": "object"
    },
    "json_schema": {
      "description": "A JSON Schema value, carried verbatim from the vendor's declaration.",
      "type": [
        "object",
        "boolean"
      ]
    },
    "oauth2": {
      "additionalProperties": false,
      "description": "The complete OAuth2 declaration. Deliberately, no field exists for a registration value: the client identifier and secret are per-deployment, published only as operator-level configuration requirements through the `binds` grammar (C-536).",
      "properties": {
        "authorize_path": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "grants": {
          "items": {
            "enum": [
              "authorization_code",
              "password",
              "refresh_token",
              "client_credentials"
            ]
          },
          "type": "array"
        },
        "public_client": {
          "type": "boolean"
        },
        "redirect": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "port",
            "path"
          ],
          "type": "object"
        },
        "scope_response_pointer": {
          "pattern": "^/",
          "type": "string"
        },
        "scope_separator": {
          "enum": [
            "space",
            "comma"
          ]
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "token_endpoint": {
          "type": "string"
        },
        "token_path": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol_driver": {
                "const": "http_v1"
              }
            }
          },
          "then": {
            "properties": {
              "request": {
                "$ref": "#/$defs/http_request"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_driver": {
                "const": "sip_v1"
              }
            }
          },
          "then": {
            "properties": {
              "request": {
                "$ref": "#/$defs/sip_request"
              }
            }
          }
        }
      ],
      "properties": {
        "auth": {
          "$ref": "#/$defs/requirements"
        },
        "auth_requirements": {
          "$ref": "#/$defs/auth_requirements"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "credential_requirement": {
          "description": "What the effective `auth` list cannot say when it is empty (S-001): whether the connector declared that nothing is required (`no-credential-required`) or declared nothing anywhere (`no-credential`, the fail-closed reading). C-206's published tokens, carried as data so no consumer resolves the connector default to reconstruct the distinction.",
          "enum": [
            "declared",
            "no-credential-required",
            "no-credential"
          ]
        },
        "description": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "read",
            "write"
          ]
        },
        "effects": {
          "items": {
            "enum": [
              "read",
              "write",
              "network",
              "process",
              "browser",
              "filesystem",
              "local_system"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "endpoint": {
          "additionalProperties": {
            "items": {
              "enum": [
                "origin",
                "host",
                "path",
                "query",
                "header"
              ]
            },
            "minItems": 1,
            "type": "array"
          },
          "type": "object"
        },
        "error_envelope": {
          "$ref": "#/$defs/error_envelope"
        },
        "expose": {
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "idempotency": {
          "enum": [
            "idempotent",
            "non_idempotent",
            "conditional"
          ]
        },
        "implementation_form": {
          "enum": [
            "built_in"
          ]
        },
        "interaction_shape": {
          "enum": [
            "unary",
            "stream",
            "subscription",
            "leased_session",
            "session_establishment"
          ]
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/param"
          },
          "type": "array"
        },
        "placement_requirement": {
          "enum": [
            "connectors_deployment",
            "substrate_workload",
            "federated_satellite"
          ]
        },
        "produces_credential": {
          "$ref": "#/$defs/produces_credential"
        },
        "protocol_driver": {
          "enum": [
            "http_v1",
            "sip_v1"
          ]
        },
        "rate_limit": {
          "$ref": "#/$defs/rate_limit"
        },
        "repeatability_condition": {
          "type": "string"
        },
        "request": {
          "type": "object"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "public_network",
              "private_network",
              "unix_socket",
              "file_secret",
              "process",
              "container",
              "device"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "response_schema": {
          "$ref": "#/$defs/json_schema"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "destructive"
          ]
        },
        "semantic_effects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "service",
        "direction",
        "risk",
        "idempotency",
        "effects",
        "semantic_effects",
        "interaction_shape",
        "protocol_driver",
        "placement_requirement",
        "implementation_form",
        "required_capabilities",
        "contract",
        "expose",
        "auth",
        "credential_requirement",
        "request"
      ],
      "type": "object"
    },
    "pagination": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "page": {
              "additionalProperties": false,
              "properties": {
                "max_pages": {
                  "type": "integer"
                },
                "page_param": {
                  "type": "string"
                },
                "page_size": {
                  "type": "integer"
                },
                "size_param": {
                  "type": "string"
                }
              },
              "required": [
                "page_param",
                "max_pages"
              ],
              "type": "object"
            }
          },
          "required": [
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "additionalProperties": false,
              "properties": {
                "cursor_param": {
                  "type": "string"
                },
                "max_pages": {
                  "type": "integer"
                },
                "next_cursor_pointer": {
                  "type": "string"
                }
              },
              "required": [
                "cursor_param",
                "next_cursor_pointer",
                "max_pages"
              ],
              "type": "object"
            }
          },
          "required": [
            "cursor"
          ],
          "type": "object"
        }
      ]
    },
    "param": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "enum": [
            "path",
            "query",
            "header",
            "body"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/json_schema"
        },
        "symbol": {
          "description": "The caller-facing symbol the contract declares this parameter by (S-001): the name a caller addresses it under, which is not its document `name`.",
          "minLength": 1,
          "type": "string"
        },
        "wire": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "position",
        "symbol",
        "required",
        "schema"
      ],
      "type": "object"
    },
    "param_splice": {
      "additionalProperties": false,
      "description": "The whole value of the named caller parameter.",
      "properties": {
        "$param": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "$param"
      ],
      "type": "object"
    },
    "produces_credential": {
      "additionalProperties": false,
      "description": "The minting join (S-001): this operation's call mints a declared credential — which credential the value is stored as, and where in the response body the secret arrives (one JSON Pointer, no wildcard).",
      "properties": {
        "credential": {
          "minLength": 1,
          "type": "string"
        },
        "secret": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "credential",
        "secret"
      ],
      "type": "object"
    },
    "rate_limit": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string"
        },
        "per_seconds": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        }
      },
      "required": [
        "requests",
        "per_seconds"
      ],
      "type": "object"
    },
    "requirements": {
      "description": "Auth alternatives: OR of AND-groups of declared credential names.",
      "items": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "type": "array"
    },
    "scheme": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bearer",
            "basic",
            "header",
            "query",
            "signing"
          ]
        },
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "selector": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
