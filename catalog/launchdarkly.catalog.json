    {
      "auth": [
        [
          "launchdarkly.api_token"
        ]
      ],
      "contract": {
        "description": "Turn a feature flag on or off in one environment. This is a live production change: every SDK instance currently evaluating this flag in this environment — web, mobile and backend alike — switches to the other branch as soon as this call returns, for every real user it serves. It is reversible by toggling back, but it is not a private or staged edit",
        "input_schema": {
          "properties": {
            "body": {
              "items": {},
              "type": "array"
            },
            "feature_flag_key": {
              "type": "string"
            },
            "project_key": {
              "type": "string"
            }
          },
          "required": [
            "project_key",
            "feature_flag_key",
            "body"
          ],
          "type": "object"
        }
      },
      "credential_requirement": "declared",
      "description": "Turn a feature flag on or off in one environment. This is a live production change: every SDK instance currently evaluating this flag in this environment — web, mobile and backend alike — switches to the other branch as soon as this call returns, for every real user it serves. It is reversible by toggling back, but it is not a private or staged edit",
      "direction": "write",
      "effects": [
        "write",
        "network"
      ],
      "expose": true,
      "id": "launchdarkly-flag-toggle",
      "idempotency": "conditional",
      "implementation_form": "built_in",
      "interaction_shape": "unary",
      "params": [
        {
          "description": "The project's own key, from launchdarkly-project-list's `key` field",
          "name": "project_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "symbol": "project_key"
        },
        {
          "description": "The flag's own key, from launchdarkly-flag-list's `key` field",
          "name": "feature_flag_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "symbol": "feature_flag_key"
        },
        {
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "description": "A JSON Patch (RFC 6902) document with exactly one operation, setting a single environment's on/off state: `[{\"op\": \"replace\", \"path\": \"/environments/<environment_key>/on\", \"value\": true}]` turns the flag on in that environment, `\"value\": false` turns it off. `<environment_key>` is that environment's own key (from launchdarkly-environment-list's `key` field), written literally into the JSON Pointer string — it is not a request parameter LaunchDarkly could confuse with a URL segment",
            "items": {
              "properties": {
                "op": {
                  "description": "This connector's curated toggle uses only `replace`; LaunchDarkly's PATCH also accepts `add`, `remove` and `test`, none of which this connector exposes",
                  "enum": [
                    "replace"
                  ],
                  "type": "string"
                },
                "path": {
                  "description": "A JSON Pointer to one environment's `on` bit: `/environments/{environment_key}/on`",
                  "pattern": "^/environments/[A-Za-z0-9._-]+/on$",
                  "type": "string"
                },
                "value": {
                  "description": "`true` turns the flag on in that environment, `false` turns it off",
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "path",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "symbol": "body"
        }
      ],
      "placement_requirement": "connectors_deployment",
      "protocol_driver": "http_v1",
      "repeatability_condition": "the body schema admits exactly one JSON Patch `replace` onto one environment's `on` bit (maxItems 1, op pinned to `replace`, path pinned to `/environments/{key}/on`), so it sets an absolute value and never a toggle or a delta — re-sending it lands the flag where the caller asked, however many times it runs",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "$param": "body"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PATCH",
        "url": "{base}/flags/{project_key}/{feature_flag_key}"
      },
      "required_capabilities": [
        "public_network"
      ],
      "response_schema": {
        "properties": {
          "environments": {
            "description": "The flag's environments after the patch was applied, in the same shape launchdarkly-flag-get returns — read the affected environment's `on` field back to confirm the toggle took effect",
            "type": "object"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "kind"
        ],
        "type": "object"
      },
