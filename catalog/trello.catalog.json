{
  "$schema": "https://github.com/beyond10x/b10x/blob/main/foundation/connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Trello API key, identifying the Power-Up registration a call is made through. Travels as the `key` query parameter on every request, always together with the token; neither authenticates a call alone",
      "env": [
        "TRELLO_API_KEY"
      ],
      "name": "trello.key",
      "scheme": {
        "kind": "query",
        "name": "key"
      },
      "subject": "unstated"
    },
    {
      "description": "Trello API token, granting access to one member's account. Travels as the `token` query parameter on every request, always together with the key; a token is only valid against the key it was minted for",
      "env": [
        "TRELLO_API_TOKEN"
      ],
      "name": "trello.token",
      "scheme": {
        "kind": "query",
        "name": "token"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.trello.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.trello.key",
      "docs_url": "https://developer.atlassian.com/cloud/trello/guides/rest-api/api-introduction/",
      "format": "token",
      "help": "Generate one at trello.com/power-ups/admin: open (or create) a Power-Up, then the API Key tab. Do this first — the token below is minted against this key and only works with it",
      "label": "Trello API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.trello.token",
      "docs_url": "https://developer.atlassian.com/cloud/trello/guides/rest-api/api-introduction/",
      "format": "token",
      "help": "From the same API Key page, follow the manual token link and click Allow. The token grants access to everything your Trello account can see, so treat it as a password",
      "label": "Trello API token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "trello",
  "default_auth": [
    [
      "trello.key",
      "trello.token"
    ]
