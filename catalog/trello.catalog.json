      "auth": [
        [
          "trello.key",
          "trello.token"
        ]
      ],
      "contract": {
        "description": "List every board the token's own member can see, newest activity first. Takes no argument — `me` resolves to whoever the token belongs to. Also this connector's `verify`: a bounded read that runs unattended and needs nothing configured beyond the credential pair",
        "input_schema": {
          "properties": {},
          "required": [],
          "type": "object"
        }
      },
      "credential_requirement": "declared",
      "description": "List every board the token's own member can see, newest activity first. Takes no argument — `me` resolves to whoever the token belongs to. Also this connector's `verify`: a bounded read that runs unattended and needs nothing configured beyond the credential pair",
      "direction": "read",
      "effects": [
        "read",
        "network"
      ],
      "expose": true,
      "id": "trello-board-list",
      "idempotency": "idempotent",
      "implementation_form": "built_in",
      "interaction_shape": "unary",
      "placement_requirement": "connectors_deployment",
      "protocol_driver": "http_v1",
      "request": {
        "method": "GET",
        "url": "{base}/members/me/boards"
      },
      "required_capabilities": [
        "public_network"
      ],
      "response_schema": {
        "items": {
          "properties": {
            "closed": {
              "description": "Whether the board is archived. An archived board still reads",
              "type": "boolean"
            },
            "dateLastActivity": {
              "description": "When anything on the board last changed",
              "type": "string"
            },
            "desc": {
              "description": "The board's description, as Markdown",
              "type": "string"
            },
            "id": {
              "description": "The board's id — what trello-board-get and trello-board-lists address it by",
              "type": "string"
            },
            "idMemberCreator": {
              "description": "The member who created the board",
              "type": "string"
            },
            "idOrganization": {
              "description": "The Workspace this board belongs to, or null for a personal board",
              "type": "string"
            },
            "labelNames": {
              "description": "The board's six label colours mapped to the names it gives them",
              "type": "object"
            },
            "name": {
              "type": "string"
            },
            "prefs": {
              "description": "Board settings — visibility, voting, card covers, background and more. Left untyped rather than enumerated in full; see Trello's own Board object reference",
              "type": "object"
            },
            "shortLink": {
              "description": "The short id appearing in a board URL",
              "type": "string"
            },
            "shortUrl": {
              "format": "uri",
              "type": "string"
            },
            "starred": {
              "type": "boolean"
            },
            "subscribed": {
              "description": "Whether the token's member follows this board",
              "type": "boolean"
            },
            "url": {
              "description": "The board's page — the link to give a human",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "closed",
            "url"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
