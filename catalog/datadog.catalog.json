{
  "$schema": "https://github.com/b10x/b10x/blob/main/connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Datadog API key. Identifies the organization; required on every request together with the Application Key — neither key alone authenticates a call",
      "env": [
        "DATADOG_API_KEY"
      ],
      "name": "datadog.api_key",
      "scheme": {
        "kind": "header",
        "name": "DD-API-KEY"
      },
      "subject": "unstated"
    },
    {
      "description": "Datadog Application Key, scoped to the user who created it. Required on every request together with the API Key — neither key alone authenticates a call",
      "env": [
        "DATADOG_APPLICATION_KEY"
      ],
      "name": "datadog.application_key",
      "scheme": {
        "kind": "header",
        "name": "DD-APPLICATION-KEY"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.datadoghq.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.datadog.api_key",
      "docs_url": "https://docs.datadoghq.com/account_management/api-app-keys/",
      "format": "token",
      "help": "Organization Settings > API Keys in the Datadog app. Sent as DD-API-KEY on every request, always together with the Application Key",
      "label": "Datadog API Key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.datadog.application_key",
      "docs_url": "https://docs.datadoghq.com/account_management/api-app-keys/",
      "format": "token",
      "help": "Organization Settings > Application Keys in the Datadog app, scoped to the user who creates it. Sent as DD-APPLICATION-KEY on every request, always together with the API Key",
      "label": "Datadog Application Key",
      "level": "connection",
      "name": "application_key",
      "required": true,
      "secret": true,
      "service": "default"
    }
