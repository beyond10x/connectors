      "placement_requirement": "connectors_deployment",
      "protocol_driver": "http_v1",
      "request": {
        "method": "GET",
        "url": "{base}/api/v1/monitor"
      },
      "required_capabilities": [
        "public_network"
      ],
      "response_schema": {
        "items": {
          "properties": {
            "created": {
              "description": "When this monitor was created",
              "type": "string"
            },
            "creator": {
              "description": "The user who created this monitor; may be absent for a system-authored monitor. Carries a name and an email address — personal data, never given an example value here",
              "type": "object"
            },
            "id": {
              "description": "Datadog's numeric id for this monitor",
              "type": "integer"
            },
            "message": {
              "description": "The notification message template; may embed @-mentions and template variables",
              "type": "string"
            },
            "modified": {
              "description": "When this monitor was last modified",
              "type": "string"
            },
            "multi": {
              "description": "Whether this is a multi-alert monitor grouped by tag",
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "description": "Evaluation and notification settings (thresholds, notify_no_data, renotify_interval, evaluation_delay, and more) — left untyped rather than enumerated in full; see Datadog's own Monitor Options reference for the complete shape",
              "type": "object"
            },
            "overall_state": {
              "description": "The monitor's current alert state, e.g. \"OK\", \"Alert\", \"Warn\", \"No Data\"",
              "type": "string"
            },
            "query": {
              "description": "The monitor's evaluation query, in Datadog's own monitor query syntax",
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "description": "The monitor's evaluation type, e.g. \"metric alert\", \"query alert\", \"service check\", \"log alert\", \"composite\"",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "type",
            "query",
            "message",
            "tags",
            "overall_state",
            "created",
            "modified"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
