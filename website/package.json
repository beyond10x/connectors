{
  "name": "connectors-website",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3100 --no-open",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3100 --no-open",
    "typecheck": "tsc --noEmit",
    "docs": "cd .. && cargo run --locked -p connectors-docs -- generate",
    "docs:check": "cd .. && cargo run --locked -p connectors-docs -- generate --check",
    "prestart": "npm run examples",
    "prebuild": "npm run examples",
    "examples": "cd .. && cargo run --locked -p connectors-build -- examples",
    "test:examples": "cd .. && cargo test --locked --offline --manifest-path website/examples/realization/Cargo.toml --target-dir website/.cache/demo/target",
    "test:browser": "node tests/smoke.mjs",
    "test:ui": "node tests/overhaul.mjs",
    "audit:public": "cd .. && cargo run --locked -p connectors-build -- docs-audit"
  },
  "dependencies": {
    "@beyond10x/docs-system": "git+https://github.com/beyond10x/docs-system.git#9d35e6324653d659e6ab3d46b761ee4b3bf8405c",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.14",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
