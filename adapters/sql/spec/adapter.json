{
  "kind": "connectors.adapter/v1",
  "id": "sql",
  "version": "0.1.0",
  "sources": [
    "https://www.postgresql.org/docs/current/sql-set-transaction.html",
    "https://www.postgresql.org/docs/current/runtime-config-client.html",
    "https://www.postgresql.org/docs/current/protocol-flow.html",
    "https://dev.mysql.com/doc/refman/8.4/en/set-transaction.html",
    "https://dev.mysql.com/doc/refman/8.4/en/server-system-variables.html",
    "https://dev.mysql.com/doc/refman/8.4/en/derived-tables.html",
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema-columns-table.html",
    "https://dev.mysql.com/doc/refman/8.4/en/kill.html",
    "https://dev.mysql.com/doc/dev/mysql-server/latest/page_protocol_binary_resultset.html",
    "https://www.postgresql.org/docs/current/catalog-pg-database.html",
    "https://www.postgresql.org/docs/current/catalog-pg-class.html",
    "https://www.postgresql.org/docs/current/catalog-pg-attribute.html",
    "https://www.postgresql.org/docs/current/catalog-pg-constraint.html",
    "https://www.postgresql.org/docs/current/catalog-pg-index.html",
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema-schemata-table.html",
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema-tables-table.html",
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema-key-column-usage-table.html",
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema-statistics-table.html"
  ],
  "configuration_schema": {
    "oneOf": [
      {
        "title": "effective local configuration",
        "description": "The document the adapter composition builds and validates at bootstrap, not the file an operator writes. The file carries ca_file; this schema describes the resolved form, in which the CA is reduced to ca_digest. See docs/local-postgres-cli.md and docs/local-mysql-cli.md for the on-disk format. The engine member is present only for MySQL: PostgreSQL is the default and is never named, so a configuration written before the engine existed keeps its revision.",
        "type": "object",
        "properties": {
          "format": {
            "const": "connectors-sql-local/1"
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "engine": {
            "const": "mysql"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allow_plaintext": {
            "type": "boolean"
          },
          "ca_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "format",
          "instance",
          "host",
          "port",
          "database",
          "user",
          "allow_plaintext",
          "ca_digest"
        ],
        "additionalProperties": false
      },
      {
        "title": "federated service configuration",
        "description": "The on-disk document read by --config in the federated service mode.",
        "type": "object",
        "properties": {
          "service": {
            "$ref": "urn:connectors:config:v1:service"
          },
          "password": {
            "$ref": "urn:connectors:config:v1:credential"
          },
          "adapter": {
            "type": "object",
            "properties": {
              "engine": {
                "enum": [
                  "postgresql",
                  "mysql"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "database": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "user": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "allow_plaintext": {
                "type": "boolean"
              },
              "ca_file": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "host",
              "port",
              "database",
              "user"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "service",
          "password",
          "adapter"
        ],
        "additionalProperties": false
      }
    ]
  },
  "operations": [
    {
      "id": "schema.list",
      "description": "Read column metadata of one schema of the connected database visible to the configured role or user. On PostgreSQL schema is required and names a schema inside the connected database. On MySQL a schema is a database: schema may be omitted or name the connected database, and any other is refused as invalid_input.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "query.read",
      "description": "Execute one bounded read-only query on the configured engine, PostgreSQL or MySQL, with text-format parameters.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "query",
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "database.list",
      "description": "List the names of the databases on the server: on PostgreSQL those the configured role may connect to (pg_database, excluding templates and databases that refuse connections), on MySQL those the configured user may see (information_schema.SCHEMATA). Rows are one column, database_name. No other database is opened.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "table.list",
      "description": "List the tables and views of one schema visible to the configured role or user. Rows are table_name, table_kind (table or view) and row_estimate, the engine's own estimate as decimal text or null (always null for a view). On PostgreSQL schema is required and names a schema inside the connected database; on MySQL schema may be omitted or name the connected database, and any other is refused as invalid_input.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "table.describe",
      "description": "Describe one table or view: one row per column in ordinal order, with column_name, native_type, is_nullable (YES or NO), column_default, ordinal_position, primary_key_position, and the foreign key the column belongs to (foreign_key, referenced_schema, referenced_table, referenced_column); a column in several foreign keys has one row per key. A generated column has a null column_default. On PostgreSQL a foreign key is reported only when the role holds USAGE on the referenced schema and a privilege on the referenced table. A table with no column visible to the configured role or user is not_found, and so, on MySQL, is a table name MySQL cannot hold (one ending in a space, or one its metadata character set cannot represent). Schema follows table.list.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "table",
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "index.list",
      "description": "List the indexes of one table, or of every table of one schema when table is omitted: one row per key column, with index_name, table_name, column_position, column_name (the expression text for an expression key part), is_unique and is_primary (YES or NO). On PostgreSQL an index built on a column the role cannot see (key, INCLUDE, expression or predicate) is left out, as table.describe leaves out the column. A table that does not exist is an empty answer; on MySQL a table name MySQL cannot hold is not_found. Schema follows table.list.",
      "contract": "datasource.relational/v1alpha1",
      "profile": "postgresql-native-text",
      "input_schema": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "native_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "native_type"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "columns",
          "rows",
          "truncated",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  ]
}
