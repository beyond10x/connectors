ameters.","id":"query.read","input_schema":{"additionalProperties":false,"properties":{"limit":{"maximum":1000,"minimum":1,"type":"integer"},"parameters":{"items":{"anyOf":[{"maxLength":8192,"type":"string"},{"type":"null"}]},"maxItems":64,"type":"array"},"query":{"maxLength":8192,"minLength":1,"type":"string"}},"required":["query","limit"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"columns":{"items":{"additionalProperties":false,"properties":{"name":{"type":"string"},"native_type":{"maxLength":512,"minLength":1,"type":"string"}},"required":["name","native_type"],"type":"object"},"type":"array"},"provenance":{"additionalProperties":false,"properties":{"instance":{"maxLength":512,"minLength":1,"type":"string"},"observed_at_unix_ms":{"minimum":0,"type":"integer"},"resource":{"type":"string"},"source_revision":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["instance","resource","observed_at_unix_ms","source_revision"],"type":"object"},"rows":{"items":{"items":{"anyOf":[{"type":"string"},{"type":"null"}]},"type":"array"},"type":"array"},"truncated":{"type":"boolean"}},"required":["columns","rows","truncated","provenance"],"type":"object"},"profile":"postgresql-native-text"},{"contract":"datasource.relational/v1alpha1","description":"List the names of the databases on the server: on PostgreSQL those the configured role may connect to (pg_database, excluding templates and databases that refuse connections), on MySQL those the configured user may see (information_schema.SCHEMATA). Rows are one column, database_name. No other database is opened.","id":"database.list","input_schema":{"additionalProperties":false,"properties":{"limit":{"maximum":1000,"minimum":1,"type":"integer"}},"required":["limit"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"columns":{"items":{"additionalProperties":false,"properties":{"name":{"type":"string"},"native_type":{"maxLength":512,"minLength":1,"type":"string"}},"req