  "configuration_schema": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "format": {
            "const": "connectors-gitlab-local/1"
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "api_base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https://.+/api/v4/$"
          },
          "ca_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "allowed_projects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "required": [
          "format",
          "instance",
          "api_base",
          "ca_digest",
          "allowed_projects"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "service": {
            "$ref": "urn:connectors:config:v1:service"
          },
          "http": {
            "$ref": "urn:connectors:config:v1:http"
          },
          "adapter": {
            "type": "object",
            "properties": {
              "allowed_projects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required": [
              "allowed_projects"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "service",
          "http",
          "adapter"
        ],
        "additionalProperties": false
      }
    ]
  },
