{
  "kind": "connectors.adapter/v2",
  "id": "gitlab",
  "version": "0.1.0",
  "sources": [
    "https://docs.gitlab.com/api/projects/",
    "https://docs.gitlab.com/api/issues/",
    "https://docs.gitlab.com/api/repository_files/",
    "https://docs.gitlab.com/api/rest/",
    "https://docs.gitlab.com/api/rest/authentication/"
  ],
  "configuration_schema": {
    "type": "object",
    "properties": {
      "service": {
        "$ref": "urn:connectors:config:v1:service"
      },
      "http": {
        "$ref": "urn:connectors:config:v1:http"
      },
      "adapter": {
        "type": "object",
        "properties": {
          "allowed_projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "required": [
          "allowed_projects"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "service",
      "http",
      "adapter"
    ],
    "additionalProperties": false
  },
  "operations": [
    {
      "id": "project.get",
      "description": "Read one configured GitLab project.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-project",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "item",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "issues.list",
      "description": "Read a bounded page of project issues.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-issues-offset",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "project",
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "items",
          "next_cursor",
          "complete",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "file.get",
      "description": "Read a versioned repository file using GitLab's base64 representation.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-file-base64",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "project",
          "path",
          "ref"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "item",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  ],
  "upstream": {
    "path": "../upstream/openapi_v3.yaml",
    "url": "https://gitlab.com/gitlab-org/gitlab/-/raw/2ff8d865e5016b14b724d1c2ce745f8300696192/doc/api/openapi/openapi_v3.yaml",
    "revision": "2ff8d865e5016b14b724d1c2ce745f8300696192",
    "sha256": "f9e830bd3d2b99c49d60a7713fe1a64f5164418aca24b559287daab075beb530",
    "base_path": "/api/v4"
  },
  "mappings": [
    {
      "operation": "project.get",
      "upstream_operation": "getApiV4ProjectsId",
      "path": "/api/v4/projects/{id}",
      "method": "get",
      "path_parameters": {
        "id": {
          "kind": "input",
          "name": "project"
        }
      },
      "query_parameters": {},
      "obligations": [
        "prepare",
        "finish"
      ]
    },
    {
      "operation": "issues.list",
      "upstream_operation": "getApiV4ProjectsIdIssues",
      "path": "/api/v4/projects/{id}/issues",
      "method": "get",
      "path_parameters": {
        "id": {
          "kind": "input",
          "name": "project"
        }
      },
      "query_parameters": {
        "per_page": {
          "kind": "input",
          "name": "limit"
        },
        "page": {
          "kind": "binding",
          "name": "page"
        },
        "order_by": {
          "kind": "constant",
          "value": "created_at"
        },
        "sort": {
          "kind": "constant",
          "value": "asc"
        }
      },
      "obligations": [
        "prepare",
        "finish"
      ]
    },
    {
      "operation": "file.get",
      "upstream_operation": "getApiV4ProjectsIdRepositoryFilesFilePath",
      "path": "/api/v4/projects/{id}/repository/files/{file_path}",
      "method": "get",
      "path_parameters": {
        "id": {
          "kind": "input",
          "name": "project"
        },
        "file_path": {
          "kind": "input",
          "name": "path"
        }
      },
      "query_parameters": {
        "ref": {
          "kind": "input",
          "name": "ref"
        }
      },
      "obligations": [
        "prepare",
        "finish"
      ]
    }
  ]
}
