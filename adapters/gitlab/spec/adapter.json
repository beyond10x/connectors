{
  "kind": "connectors.adapter/v1",
  "id": "gitlab",
  "version": "0.1.0",
  "sources": [
    "https://docs.gitlab.com/api/projects/",
    "https://docs.gitlab.com/api/issues/",
    "https://docs.gitlab.com/api/repository_files/",
    "https://docs.gitlab.com/api/rest/",
    "https://docs.gitlab.com/api/rest/authentication/"
  ],
  "configuration_schema": {
    "type": "object",
    "properties": {
      "service": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "listen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "service_credential": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "environment"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "instance",
          "listen",
          "service_credential"
        ],
        "additionalProperties": false
      },
      "http": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "credential": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "environment"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "file"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "kind",
                      "path"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "credential_header": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bearer": {
            "type": "boolean"
          },
          "allow_plaintext": {
            "type": "boolean"
          },
          "ca_file": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "base_url"
        ],
        "additionalProperties": false
      },
      "adapter": {
        "type": "object",
        "properties": {
          "allowed_projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "required": [
          "allowed_projects"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "service",
      "http",
      "adapter"
    ],
    "additionalProperties": false
  },
  "operations": [
    {
      "id": "project.get",
      "description": "Read one configured GitLab project.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-project",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "item",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "issues.list",
      "description": "Read a bounded page of project issues.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-issues-offset",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "project",
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "items",
          "next_cursor",
          "complete",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "file.get",
      "description": "Read a versioned repository file using GitLab's base64 representation.",
      "contract": "datasource.records/v1alpha1",
      "profile": "gitlab-file-base64",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "project",
          "path",
          "ref"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
              "observed_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "source_revision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "item",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  ]
}
