{
  "format": "connectors-catalog-operations/1",
  "provider": "gitlab",
  "operations": [
    {"id": "project.get", "operation_id": "getApiV4ProjectsId", "effect": "read",
     "description": "Read one project"},
    {"id": "issues.list", "operation_id": "getApiV4ProjectsIdIssues", "effect": "read",
     "description": "List a project's issues, one page per call"},
    {"id": "file.get", "operation_id": "getApiV4ProjectsIdRepositoryFilesFilePath", "effect": "read",
     "description": "Read one repository file at a ref"},
    {"id": "branch.get", "operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch", "effect": "read",
     "description": "Read one branch and its head commit"},
    {"id": "merge_requests.list", "operation_id": "getApiV4ProjectsIdMergeRequests", "effect": "read",
     "description": "List a project's merge requests, one page per call"},
    {"id": "merge_request.get", "operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "read",
     "description": "Read one merge request"},
    {"id": "pipelines.list", "operation_id": "getApiV4ProjectsIdPipelines", "effect": "read",
     "description": "List a project's pipelines, one page per call"},
    {"id": "pipeline.get", "operation_id": "getApiV4ProjectsIdPipelinesPipelineId", "effect": "read",
     "description": "Read one pipeline"},
    {"id": "pipeline.jobs", "operation_id": "getApiV4ProjectsIdPipelinesPipelineIdJobs", "effect": "read",
     "description": "List one pipeline's jobs, one page per call"},
    {"id": "job.get", "operation_id": "getApiV4ProjectsIdJobsJobId", "effect": "read",
     "description": "Read one job"},
    {"id": "job.trace", "operation_id": "getApiV4ProjectsIdJobsJobIdTrace", "effect": "read",
     "description": "Read one job's log as text; the pinned source declares JSON, the provider answers text/plain",
     "response": "text"},
    {"id": "merge_request.create", "operation_id": "postApiV4ProjectsIdMergeRequests", "effect": "write",
     "description": "Open a merge request whose source branch head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch",
                     "values": {"id": "id", "branch": "body.source_branch"},
                     "checks": [{"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.update", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "write",
     "description": "Change an open merge request whose head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.merge", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIidMerge", "effect": "write",
     "description": "Merge an open, mergeable merge request at the pinned head after the pinned pipeline succeeded",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "body.sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}},
                                {"pointer": "/detailed_merge_status", "expect": {"literal": "mergeable"}},
                                {"pointer": "/head_pipeline/id", "expect": {"input": "pipeline_id"}},
                                {"pointer": "/head_pipeline/status", "expect": {"literal": "success"}}]},
       "postflight": {"checks": [{"pointer": "/state", "expect": {"literal": "merged"}},
                                 {"pointer": "/sha", "expect": {"input": "body.sha"}}]}}}
  ]
}
