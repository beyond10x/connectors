{
  "format": "connectors-catalog-operations/1",
  "provider": "gitlab",
  "operations": [
    {"id": "project.get", "operation_id": "getApiV4ProjectsId", "effect": "read",
     "description": "Read one project"},
    {"id": "issues.list", "operation_id": "getApiV4ProjectsIdIssues", "effect": "read",
     "description": "List a project's issues, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "file.get", "operation_id": "getApiV4ProjectsIdRepositoryFilesFilePath", "effect": "read",
     "description": "Read one repository file at a ref"},
    {"id": "branch.get", "operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch", "effect": "read",
     "description": "Read one branch and its head commit"},
    {"id": "merge_requests.list", "operation_id": "getApiV4ProjectsIdMergeRequests", "effect": "read",
     "description": "List a project's merge requests, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "merge_request.get", "operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "read",
     "description": "Read one merge request"},
    {"id": "pipelines.list", "operation_id": "getApiV4ProjectsIdPipelines", "effect": "read",
     "description": "List a project's pipelines, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "pipeline.get", "operation_id": "getApiV4ProjectsIdPipelinesPipelineId", "effect": "read",
     "description": "Read one pipeline"},
    {"id": "pipeline.jobs", "operation_id": "getApiV4ProjectsIdPipelinesPipelineIdJobs", "effect": "read",
     "description": "List one pipeline's jobs, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "job.get", "operation_id": "getApiV4ProjectsIdJobsJobId", "effect": "read",
     "description": "Read one job"},
    {"id": "job.trace", "operation_id": "getApiV4ProjectsIdJobsJobIdTrace", "effect": "read",
     "description": "Read one job's log as text; the pinned source declares JSON, the provider answers text/plain",
     "response": "text"},
    {"id": "projects.list", "operation_id": "getApiV4Projects", "effect": "read",
     "description": "List projects, one page per call; last_activity_after filters by time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "tags.list", "operation_id": "getApiV4ProjectsIdRepositoryTags", "effect": "read",
     "description": "List a project's repository tags, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "releases.list", "operation_id": "getApiV4ProjectsIdReleases", "effect": "read",
     "description": "List a project's releases, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "project.events", "operation_id": "getApiV4ProjectsIdEvents", "effect": "read",
     "description": "List a project's events, one page per call; after and before filter by date",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "commits.list", "operation_id": "getApiV4ProjectsIdRepositoryCommits", "effect": "read",
     "description": "List a ref's commits with their parent ids, one page per call; since and until filter by commit time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}},
     "withhold": ["pagination", "page_token"]},
    {"id": "repository.compare", "operation_id": "getApiV4ProjectsIdRepositoryCompare", "effect": "read",
     "description": "Compare two refs; a true compare_timeout means GitLab stopped early, not that no commits lie between them"},
    {"id": "deployments.list", "operation_id": "getApiV4ProjectsIdDeployments", "effect": "read",
     "description": "List a project's deployments with their environment and job, one page per call; updated_after, updated_before, finished_after and finished_before filter by time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "issue.create", "operation_id": "postApiV4ProjectsIdIssues", "effect": "write",
     "description": "Open one issue in project id from body; GitLab requires body.title. Unguarded: nothing exists to compare before a create, so the same input approved and sent again opens a second issue. Among other effects, body.assignee_ids assigns users, body.confidential makes it confidential, body.discussion_locked locks its discussion, body.merge_request_to_resolve_discussions_of resolves a merge request's discussions and body.iid and body.created_at, available only to administrators and project owners, set its internal id and creation time; this list is not exhaustive: the approval binds the whole input by digest, so read the whole input before approving"},
    {"id": "merge_request.create", "operation_id": "postApiV4ProjectsIdMergeRequests", "effect": "write",
     "description": "Open a merge request whose source branch head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch",
                     "values": {"id": "id", "branch": "body.source_branch"},
                     "checks": [{"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.update", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "write",
     "description": "Change an open merge request whose head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.merge", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIidMerge", "effect": "write",
     "description": "Merge an open, mergeable merge request at the pinned head after the pinned pipeline succeeded",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "body.sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}},
                                {"pointer": "/detailed_merge_status", "expect": {"literal": "mergeable"}},
                                {"pointer": "/head_pipeline/id", "expect": {"input": "pipeline_id"}},
                                {"pointer": "/head_pipeline/status", "expect": {"literal": "success"}}]},
       "postflight": {"checks": [{"pointer": "/state", "expect": {"literal": "merged"}},
                                 {"pointer": "/sha", "expect": {"input": "body.sha"}}]}}}
  ],
  "feed": {
    "profile": "gitlab-merge-requests/1",
    "capabilities": {"deletions": "not-observed", "kind": "fixed-word",
                     "revision": "update-time", "visibility": "all-private"},
    "max_limit": 100,
    "containers": {
      "operation_id": "getApiV4Projects",
      "lookup": {"operation_id": "getApiV4ProjectsId", "parameter": "id", "record": ""},
      "query": {"membership": "true", "order_by": "id", "sort": "asc"},
      "limit": "per_page",
      "cursor": {"parameter": "id_after", "last": "/id"},
      "records": "",
      "id": "/id",
      "name": "/name_with_namespace",
      "kind_word": "project"
    },
    "items": {
      "operation_id": "getApiV4ProjectsIdMergeRequests",
      "container": "id",
      "query": {"order_by": "updated_at", "sort": "asc", "state": "all", "scope": "all"},
      "limit": "per_page",
      "position": {"kind": "time", "value": {"parameter": "updated_after"}},
      "records": "",
      "id": "/iid",
      "revision": "/updated_at",
      "created_at": "/created_at",
      "updated_at": "/updated_at",
      "author": {"id": "/author/id", "display_name": "/author/name"},
      "body": {"pointer": "/description", "representation": "text/markdown"}
    }
  }
}
