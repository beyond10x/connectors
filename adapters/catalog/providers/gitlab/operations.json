{
  "format": "connectors-catalog-operations/1",
  "provider": "gitlab",
  "operations": [
    {"id": "project.get", "operation_id": "getApiV4ProjectsId", "effect": "read",
     "description": "Read one project"},
    {"id": "issues.list", "operation_id": "getApiV4ProjectsIdIssues", "effect": "read",
     "description": "List a project's issues, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "file.get", "operation_id": "getApiV4ProjectsIdRepositoryFilesFilePath", "effect": "read",
     "description": "Read one repository file at a ref"},
    {"id": "branch.get", "operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch", "effect": "read",
     "description": "Read one branch and its head commit"},
    {"id": "merge_requests.list", "operation_id": "getApiV4ProjectsIdMergeRequests", "effect": "read",
     "description": "List a project's merge requests, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "merge_request.get", "operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "read",
     "description": "Read one merge request"},
    {"id": "pipelines.list", "operation_id": "getApiV4ProjectsIdPipelines", "effect": "read",
     "description": "List a project's pipelines, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "pipeline.get", "operation_id": "getApiV4ProjectsIdPipelinesPipelineId", "effect": "read",
     "description": "Read one pipeline"},
    {"id": "pipeline.jobs", "operation_id": "getApiV4ProjectsIdPipelinesPipelineIdJobs", "effect": "read",
     "description": "List one pipeline's jobs, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "job.get", "operation_id": "getApiV4ProjectsIdJobsJobId", "effect": "read",
     "description": "Read one job"},
    {"id": "job.trace", "operation_id": "getApiV4ProjectsIdJobsJobIdTrace", "effect": "read",
     "description": "Read one job's log as text; the pinned source declares JSON, the provider answers text/plain",
     "response": "text"},
    {"id": "projects.list", "operation_id": "getApiV4Projects", "effect": "read",
     "description": "List projects, one page per call; last_activity_after filters by time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "tags.list", "operation_id": "getApiV4ProjectsIdRepositoryTags", "effect": "read",
     "description": "List a project's repository tags, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "releases.list", "operation_id": "getApiV4ProjectsIdReleases", "effect": "read",
     "description": "List a project's releases, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "project.events", "operation_id": "getApiV4ProjectsIdEvents", "effect": "read",
     "description": "List a project's events, one page per call; after and before filter by date",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "commits.list", "operation_id": "getApiV4ProjectsIdRepositoryCommits", "effect": "read",
     "description": "List a ref's commits with their parent ids, one page per call; since and until filter by commit time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}},
     "withhold": ["pagination", "page_token"]},
    {"id": "repository.compare", "operation_id": "getApiV4ProjectsIdRepositoryCompare", "effect": "read",
     "description": "Compare two refs; a true compare_timeout means GitLab stopped early, not that no commits lie between them"},
    {"id": "deployments.list", "operation_id": "getApiV4ProjectsIdDeployments", "effect": "read",
     "description": "List a project's deployments with their environment and job, one page per call; updated_after, updated_before, finished_after and finished_before filter by time",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "issue.create", "operation_id": "postApiV4ProjectsIdIssues", "effect": "write",
     "description": "Open one issue in project id from body; GitLab requires body.title. Unguarded: nothing exists to compare before a create, so the same input approved and sent again opens a second issue. Among other effects, body.assignee_ids assigns users, body.confidential makes it confidential, body.discussion_locked locks its discussion, body.merge_request_to_resolve_discussions_of resolves a merge request's discussions and body.iid and body.created_at, available only to administrators and project owners, set its internal id and creation time; this list is not exhaustive: the approval binds the whole input by digest, so read the whole input before approving"},
    {"id": "merge_request.create", "operation_id": "postApiV4ProjectsIdMergeRequests", "effect": "write",
     "description": "Open a merge request whose source branch head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryBranchesBranch",
                     "values": {"id": "id", "branch": "body.source_branch"},
                     "checks": [{"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.update", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "write",
     "description": "Change an open merge request whose head is the pinned sha",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}}]}}},
    {"id": "merge_request.merge", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIidMerge", "effect": "write",
     "description": "Merge an open, mergeable merge request at the pinned head after the pinned pipeline succeeded",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "body.sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}},
                                {"pointer": "/detailed_merge_status", "expect": {"literal": "mergeable"}},
                                {"pointer": "/head_pipeline/id", "expect": {"input": "pipeline_id"}},
                                {"pointer": "/head_pipeline/status", "expect": {"literal": "success"}}]},
       "postflight": {"checks": [{"pointer": "/state", "expect": {"literal": "merged"}},
                                 {"pointer": "/sha", "expect": {"input": "body.sha"}}]}}},
    {"id": "merge_request.note.create", "operation_id": "postApiV4ProjectsIdMergeRequestsNoteableIdNotes", "effect": "write",
     "description": "Add one note to merge request noteable_id (its IID) in project id; body.body is the text, body.internal true makes it internal. Unguarded: nothing exists to compare before a create, so the same input approved and sent again adds a second note. GitLab runs quick actions in the text, such as /close, /approve or /assign_reviewer, so read the whole text before approving",
     "body_keys": ["body", "internal"], "body_types": {"body": "string", "internal": "boolean"}, "body_required": ["body"]},
    {"id": "merge_request.discussion.get", "operation_id": "getApiV4ProjectsIdMergeRequestsNoteableIdDiscussionsDiscussionId", "effect": "read",
     "description": "Read one discussion of merge request noteable_id (its IID) by discussion_id, with its notes and its resolvable and resolved state"},
    {"id": "merge_request.discussion.reply", "operation_id": "postApiV4ProjectsIdMergeRequestsNoteableIdDiscussionsDiscussionIdNotes", "effect": "write",
     "description": "Add one reply, body.body, to discussion discussion_id of merge request noteable_id (its IID). Unguarded: the same input approved and sent again adds a second reply. GitLab runs quick actions in the text, so read the whole text before approving",
     "body_keys": ["body"], "body_types": {"body": "string"}, "body_required": ["body"]},
    {"id": "merge_request.discussion.resolve", "operation_id": "putApiV4ProjectsIdMergeRequestsNoteableIdDiscussionsDiscussionId", "effect": "write",
     "description": "Resolve (body.resolved true) or unresolve (false) one resolvable discussion of merge request noteable_id (its IID); body.resolved is a JSON boolean. The discussion read before and GitLab's answer after must both be discussion_id, and the answer must carry the requested state",
     "body_keys": ["resolved"], "body_types": {"resolved": "boolean"},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsNoteableIdDiscussionsDiscussionId",
                     "values": {"id": "id", "noteable_id": "noteable_id", "discussion_id": "discussion_id"},
                     "checks": [{"pointer": "/id", "expect": {"input": "discussion_id"}},
                                {"pointer": "/resolvable", "expect": {"literal": "true"}}]},
       "postflight": {"checks": [{"pointer": "/id", "expect": {"input": "discussion_id"}},
                                 {"pointer": "/resolved", "expect": {"input": "body.resolved"}}]}}},
    {"id": "repository.tree", "operation_id": "getApiV4ProjectsIdRepositoryTree", "effect": "read",
     "description": "List the files and directories under path at ref, recursive to descend, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}},
     "withhold": ["pagination", "page_token"]},
    {"id": "commit.get", "operation_id": "getApiV4ProjectsIdRepositoryCommitsSha", "effect": "read",
     "description": "Read one commit by sha, a commit id, branch or tag name; stats adds its line counts"},
    {"id": "commit.diff", "operation_id": "getApiV4ProjectsIdRepositoryCommitsShaDiff", "effect": "read",
     "description": "List one commit's file diffs, one page per call; unidiff selects the unified format",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "branches.list", "operation_id": "getApiV4ProjectsIdRepositoryBranches", "effect": "read",
     "description": "List a project's branches with their head commits, one page per call; search and regex filter by name",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}},
     "withhold": ["page_token"]},
    {"id": "search.blobs", "operation_id": "getApiV4ProjectsIdDashSearch", "effect": "read",
     "description": "Search a project's code for an expression, one page per call; scope is held to blobs, ref selects a branch or tag",
     "bounds": {"scope": {"values": ["blobs"]}, "per_page": {"minimum": 1, "maximum": 100}},
     "withhold": ["type", "state", "confidential", "fields"]},
    {"id": "merge_request.auto_merge", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIidMerge", "effect": "write",
     "description": "Set an open merge request at the pinned head to merge when its pipeline succeeds (auto_merge, fixed to true), or merge it at once when the pipeline already has",
     "body_keys": ["auto_merge", "sha"], "body_fixed": {"auto_merge": true},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "body.sha"}},
                                {"pointer": "/state", "expect": {"literal": "opened"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "body.sha"}}],
                      "any_of": [{"pointer": "/merge_when_pipeline_succeeds", "expect": {"literal": "true"}},
                                 {"pointer": "/state", "expect": {"literal": "merged"}}]}}},
    {"id": "merge_request.reopen", "operation_id": "putApiV4ProjectsIdMergeRequestsMergeRequestIid", "effect": "write",
     "description": "Reopen a closed merge request whose head is the pinned sha (state_event, fixed to reopen)",
     "body_keys": ["state_event"], "body_fixed": {"state_event": "reopen"},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIid",
                     "values": {"id": "id", "merge_request_iid": "merge_request_iid"},
                     "checks": [{"pointer": "/sha", "expect": {"input": "sha"}},
                                {"pointer": "/state", "expect": {"literal": "closed"}}]},
       "postflight": {"checks": [{"pointer": "/sha", "expect": {"input": "sha"}},
                                 {"pointer": "/state", "expect": {"literal": "opened"}}]}}},
    {"id": "merge_request.diffs", "operation_id": "getApiV4ProjectsIdMergeRequestsMergeRequestIidDiffs", "effect": "read",
     "description": "List one merge request's file diffs by its IID, one page per call; unidiff selects the unified format",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "merge_request.discussions", "operation_id": "getApiV4ProjectsIdMergeRequestsNoteableIdDiscussions", "effect": "read",
     "description": "List the discussions of merge request noteable_id (its IID), each with its notes, id and resolvable and resolved state, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "tag.get", "operation_id": "getApiV4ProjectsIdRepositoryTagsTagName", "effect": "read",
     "description": "Read one repository tag by tag_name, with its commit, message and release"},
    {"id": "tag.create", "operation_id": "postApiV4ProjectsIdRepositoryTags", "effect": "write",
     "description": "Create tag body.tag_name at body.ref (a branch, tag or commit) while that ref is the pinned commit sha; body.message makes it annotated. The provider reads the commit body.ref names first and refuses before any write when it is not sha, and the answer must name the tag at sha; a ref moved between that read and the create leaves the effect unknown. GitLab refuses a tag that already exists",
     "body_keys": ["tag_name", "ref", "message"],
     "body_types": {"tag_name": "string", "ref": "string", "message": "string"},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryCommitsSha",
                     "values": {"id": "id", "sha": "body.ref"},
                     "checks": [{"pointer": "/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/name", "expect": {"input": "body.tag_name"}},
                                 {"pointer": "/commit/id", "expect": {"input": "sha"}}]}}},
    {"id": "tag.delete", "operation_id": "deleteApiV4ProjectsIdRepositoryTagsTagName", "effect": "write",
     "description": "Delete tag tag_name while it points at the pinned commit sha. The provider reads the tag first and refuses before any write when it is absent or at another commit, and reads it again after GitLab's 204: only a 404 there proves it gone, so a tag still found or a read that fails leaves the effect unknown. GitLab has no conditional delete: a tag deleted and recreated at another commit between that first read and the delete is deleted and still reported applied",
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryTagsTagName",
                     "values": {"id": "id", "tag_name": "tag_name"},
                     "checks": [{"pointer": "/name", "expect": {"input": "tag_name"}},
                                {"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [],
                      "read": {"operation_id": "getApiV4ProjectsIdRepositoryTagsTagName",
                               "values": {"id": "id", "tag_name": "tag_name"}},
                      "absent": true}}},
    {"id": "release.get", "operation_id": "getApiV4ProjectsIdReleasesTagName", "effect": "read",
     "description": "Read the release of tag tag_name, with its commit, description and assets; include_html_description adds the rendered description"},
    {"id": "release.links", "operation_id": "getApiV4ProjectsIdReleasesTagNameAssetsLinks", "effect": "read",
     "description": "List the asset links of the release of tag tag_name, one page per call",
     "bounds": {"per_page": {"minimum": 1, "maximum": 100}}},
    {"id": "release.create", "operation_id": "postApiV4ProjectsIdReleases", "effect": "write",
     "description": "Create the release of the existing tag body.tag_name while it points at the pinned commit sha, with body.name, body.description (Markdown), body.released_at, body.milestones or body.milestone_ids and body.assets.links. The provider reads the tag first and refuses before any write when it is absent or at another commit, and the answer must name the release of that tag at sha. The body admits neither ref nor tag_message, so it never creates a tag: create one with tag.create first. GitLab refuses a second release of one tag (409)",
     "body_keys": ["tag_name", "name", "description", "released_at", "milestones", "milestone_ids", "assets"],
     "body_types": {"tag_name": "string", "name": "string", "description": "string", "released_at": "string"},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdRepositoryTagsTagName",
                     "values": {"id": "id", "tag_name": "body.tag_name"},
                     "checks": [{"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/tag_name", "expect": {"input": "body.tag_name"}},
                                 {"pointer": "/commit/id", "expect": {"input": "sha"}}]}}},
    {"id": "release.update", "operation_id": "putApiV4ProjectsIdReleasesTagName", "effect": "write",
     "description": "Change the release of tag tag_name while its commit is the pinned sha: body.name, body.description (Markdown), body.released_at, body.milestones or body.milestone_ids, each replacing the stored value (an empty milestones list removes every milestone). The provider reads the release first and refuses before any write when it is absent or at another commit, and the answer must name the same tag and commit",
     "body_keys": ["name", "description", "released_at", "milestones", "milestone_ids"],
     "body_types": {"name": "string", "description": "string", "released_at": "string"},
     "guard": {
       "preflight": {"operation_id": "getApiV4ProjectsIdReleasesTagName",
                     "values": {"id": "id", "tag_name": "tag_name"},
                     "checks": [{"pointer": "/tag_name", "expect": {"input": "tag_name"}},
                                {"pointer": "/commit/id", "expect": {"input": "sha"}}]},
       "postflight": {"checks": [{"pointer": "/tag_name", "expect": {"input": "tag_name"}},
                                 {"pointer": "/commit/id", "expect": {"input": "sha"}}]}}}
  ],
  "feed": {
    "profile": "gitlab-merge-requests/1",
    "capabilities": {"deletions": "not-observed", "kind": "fixed-word",
                     "revision": "update-time", "visibility": "all-private"},
    "max_limit": 100,
    "containers": {
      "operation_id": "getApiV4Projects",
      "lookup": {"operation_id": "getApiV4ProjectsId", "parameter": "id", "record": ""},
      "query": {"membership": "true", "order_by": "id", "sort": "asc"},
      "limit": "per_page",
      "cursor": {"parameter": "id_after", "last": "/id"},
      "records": "",
      "id": "/id",
      "name": "/name_with_namespace",
      "kind_word": "project"
    },
    "items": {
      "operation_id": "getApiV4ProjectsIdMergeRequests",
      "container": "id",
      "query": {"order_by": "updated_at", "sort": "asc", "state": "all", "scope": "all"},
      "limit": "per_page",
      "position": {"kind": "time", "value": {"parameter": "updated_after"}},
      "records": "",
      "id": "/iid",
      "revision": "/updated_at",
      "created_at": "/created_at",
      "updated_at": "/updated_at",
      "author": {"id": "/author/id", "display_name": "/author/name"},
      "body": {"pointer": "/description", "representation": "text/markdown"}
    }
  }
}
