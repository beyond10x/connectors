{
  "format": "connectors-catalog-operations/1",
  "provider": "confluence-v1",
  "operations": [
    {"id": "spaces.list", "operation_id": "getSpaces", "effect": "read",
     "description": "List the spaces the account can see, one page per call; the walk sends the start from _links.next and ends on a page without it",
     "bounds": {"limit": {"minimum": 1, "maximum": 100}},
     "walk": {"parameter": "start", "next": "/_links/next", "url_parameter": "start", "records": "/results",
              "ends": [{"name": "no_next_link", "absent": "/_links/next"}]}},
    {"id": "space.get", "operation_id": "getSpace", "effect": "read",
     "description": "Read one space by its key"},
    {"id": "space.pages", "operation_id": "getContent", "effect": "read",
     "description": "List one space's content of one type (spaceKey, type page or blogpost), one page per call; the walk sends the start from _links.next and ends on a page without it",
     "bounds": {"limit": {"minimum": 1, "maximum": 100}},
     "walk": {"parameter": "start", "next": "/_links/next", "url_parameter": "start", "records": "/results",
              "ends": [{"name": "no_next_link", "absent": "/_links/next"}]}},
    {"id": "pages.changed", "operation_id": "searchContentByCQL", "effect": "read",
     "description": "List the content a CQL query selects, such as the pages of one space modified since a time (space = KEY and type = page and lastmodified >= \"2026-09-01\" order by lastmodified desc), one page per call; the walk sends the cursor from _links.next and ends on a page without it",
     "bounds": {"limit": {"minimum": 1, "maximum": 100}},
     "walk": {"parameter": "cursor", "next": "/_links/next", "url_parameter": "cursor", "records": "/results",
              "ends": [{"name": "no_next_link", "absent": "/_links/next"}]}},
    {"id": "page.get", "operation_id": "getContentById", "effect": "read",
     "description": "Read one page; ask for expand body.storage to receive its body in storage format"},
    {"id": "page.comments", "operation_id": "getContentComments", "effect": "read",
     "description": "List one page's comments (location footer for footer comments), one page per call; the walk sends the start from _links.next and ends on a page without it",
     "bounds": {"limit": {"minimum": 1, "maximum": 100}},
     "walk": {"parameter": "start", "next": "/_links/next", "url_parameter": "start", "records": "/results",
              "ends": [{"name": "no_next_link", "absent": "/_links/next"}]}},
    {"id": "content.search", "operation_id": "searchByCQL", "effect": "read",
     "description": "Search the site with a CQL query (cql, required; such as type = page and text ~ \"release notes\"), one page of results per call, each with title, excerpt, url, lastModified and the matched content; the walk sends the cursor from _links.next and ends on a page without it",
     "bounds": {"limit": {"minimum": 1, "maximum": 100}},
     "walk": {"parameter": "cursor", "next": "/_links/next", "url_parameter": "cursor", "records": "/results",
              "ends": [{"name": "no_next_link", "absent": "/_links/next"}]}}
  ],
  "feed": {
    "profile": "confluence-pages/1",
    "capabilities": {"deletions": "not-observed", "kind": "fixed-word",
                     "revision": "opaque", "visibility": "all-private"},
    "max_limit": 100,
    "containers": {
      "operation_id": "getSpaces",
      "lookup": {"operation_id": "getSpace", "parameter": "spaceKey", "record": ""},
      "query": {"status": "current"},
      "limit": "limit",
      "cursor": {"parameter": "start", "next": "/_links/next", "url_parameter": "start"},
      "records": "/results",
      "id": "/key",
      "name": "/name",
      "kind_word": "space"
    },
    "items": {
      "operation_id": "searchContentByCQL",
      "query": {"expand": "history,version"},
      "limit": "limit",
      "position": {"kind": "time", "value": {
        "query": {"parameter": "cql", "language": "cql",
                  "first": "space = {container} and type = page order by lastmodified asc",
                  "resume": "space = {container} and type = page and lastmodified >= {since} order by lastmodified asc",
                  "utc_offsets": {"least": -720, "greatest": 840}},
        "precision": "minute",
        "page": {"parameter": "cursor", "next": "/_links/next", "url_parameter": "cursor"}}},
      "records": "/results",
      "id": "/id",
      "revision": "/version/number",
      "created_at": "/history/createdDate",
      "updated_at": "/version/when",
      "author": {"id": "/history/createdBy/accountId", "display_name": "/history/createdBy/displayName"},
      "body": {"pointer": "/title", "representation": "text/plain"},
      "url": "/_links/webui",
      "url_base": "/_links/base"
    }
  }
}
