{
  "format": "connectors-catalog-operations/1",
  "provider": "feed-fixture",
  "operations": [],
  "feed": {
    "profile": "feed-fixture-next/1",
    "capabilities": {"deletions": "observed", "kind": "provider-word", "revision": "opaque", "visibility": "mapped"},
    "max_limit": 100,
    "containers": {
      "operation_id": "listRoomDirectory",
      "lookup": {"operation_id": "getRoom", "parameter": "room", "record": "/room"},
      "limit": "limit",
      "cursor": {"parameter": "start", "next": "/_links/next", "url_parameter": "start"},
      "records": "/results",
      "id": "/id",
      "name": "/title",
      "kind": "/type",
      "visibility": {"pointer": "/access", "map": {"open": "public", "invite": "private", "im": "direct"}}
    },
    "items": {
      "operation_id": "queryMessages",
      "limit": "limit",
      "position": {
        "kind": "time",
        "value": {
          "query": {
            "parameter": "filter",
            "language": "cql",
            "first": "room = {container} ORDER BY edited ASC",
            "resume": "room = {container} AND edited >= {since} ORDER BY edited ASC"
          },
          "precision": "minute",
          "page": {"parameter": "after", "next": "/_links/next", "url_parameter": "after"}
        }
      },
      "records": "/results",
      "id": "/id",
      "revision": "/version",
      "created_at": "/created",
      "updated_at": "/edited",
      "author": {"id": "/user/id", "display_name": "/user/name"},
      "body": {"pointer": "/text", "representation": "text/plain"},
      "url": "/_links/webui",
      "url_base": "/_links/base",
      "parent": "/reply_to",
      "deleted": {"pointer": "/deleted", "equals": true}
    }
  }
}
