{
  "format": "connectors-catalog-operations/1",
  "provider": "feed-fixture",
  "operations": [],
  "feed": {
    "profile": "feed-fixture-query/1",
    "capabilities": {"deletions": "observed", "kind": "provider-word", "revision": "opaque", "visibility": "mapped"},
    "max_limit": 100,
    "containers": {
      "operation_id": "listRoomIndex",
      "lookup": {"operation_id": "getRoom", "parameter": "room", "record": "/room"},
      "limit": "maxResults",
      "cursor": {"parameter": "startAt", "offset": {"complete": {"pointer": "/isLast", "equals": true}}},
      "records": "/values",
      "id": "/id",
      "name": "/title",
      "kind": "/type",
      "visibility": {"pointer": "/access", "map": {"open": "public", "invite": "private", "im": "direct"}}
    },
    "items": {
      "operation_id": "searchMessages",
      "limit": "maxResults",
      "position": {
        "kind": "time",
        "value": {
          "query": {
            "parameter": "q",
            "language": "jql",
            "first": "room = {container} ORDER BY edited ASC",
            "resume": "room = {container} AND edited >= {since} ORDER BY edited ASC"
          },
          "precision": "minute",
          "page": {"parameter": "pageToken", "next": "/nextPageToken"}
        }
      },
      "records": "/issues",
      "id": "/id",
      "revision": "/fields/version",
      "created_at": "/fields/created",
      "updated_at": "/fields/updated",
      "author": {"id": "/fields/reporter/accountId", "display_name": "/fields/reporter/displayName"},
      "body": {"pointer": "/fields/text", "representation": "text/plain"},
      "url": "/fields/link",
      "parent": "/fields/reply_to",
      "deleted": {"pointer": "/fields/removed", "equals": true}
    }
  }
}
