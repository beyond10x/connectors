{
  "profile": "confluence-pages/1",
  "capabilities": {
    "deletions": "not-observed",
    "kind": "fixed-word",
    "revision": "opaque",
    "visibility": "all-private"
  },
  "max_limit": 100,
  "containers": {
    "operation_id": "getSpaces",
    "lookup": {
      "operation_id": "getSpace",
      "parameter": "spaceKey",
      "record": ""
    },
    "query": {
      "status": "current"
    },
    "limit": "limit",
    "cursor": {
      "parameter": "start",
      "next": "/_links/next",
      "url_parameter": "start"
    },
    "records": "/results",
    "id": "/key",
    "name": "/name",
    "kind_word": "space"
  },
  "items": {
    "operation_id": "searchContentByCQL",
    "query": {
      "expand": "history,version"
    },
    "limit": "limit",
    "position": {
      "kind": "time",
      "value": {
        "query": {
          "parameter": "cql",
          "language": "cql",
          "first": "space = {container} and type = page order by lastmodified asc",
          "resume": "space = {container} and type = page and lastmodified >= {since} order by lastmodified asc",
          "utc_offsets": {
            "least": -720,
            "greatest": 840
          }
        },
        "precision": "minute",
        "page": {
          "parameter": "cursor",
          "next": "/_links/next",
          "url_parameter": "cursor"
        }
      }
    },
    "records": "/results",
    "id": "/id",
    "revision": "/version/number",
    "created_at": "/history/createdDate",
    "updated_at": "/version/when",
    "author": {
      "id": "/history/createdBy/accountId",
      "display_name": "/history/createdBy/displayName"
    },
    "body": {
      "pointer": "/title",
      "representation": "text/plain"
    },
    "url": "/_links/webui",
    "url_base": "/_links/base"
  }
}
