{
  "kind": "connectors.adapter/v1",
  "id": "grafana",
  "version": "0.1.0",
  "sources": [
    "https://grafana.com/docs/grafana/latest/developers/http_api/data_source/"
  ],
  "configuration_schema": {
    "title": "effective local configuration",
    "description": "The document the adapter composition builds and validates at bootstrap, not the file an operator writes. The file (connectors_grafana.connection.LocalConfiguration in spec/ess) carries ca_file; this resolved form reduces the CA to ca_digest and carries the canonical base_url. See adapters/grafana/README.md.",
    "type": "object",
    "properties": {
      "format": {
        "const": "connectors-grafana-local/1"
      },
      "instance": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "base_url": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "ca_digest": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "format",
      "instance",
      "base_url",
      "ca_digest"
    ],
    "additionalProperties": false
  },
  "operations": [
    {
      "id": "datasources.list",
      "description": "List the data sources the service account can read: uid, name, plugin type, access mode and whether it is the default. One GET /api/datasources; unpaged, at most 1,000 records. Backend URLs, credentials and settings are never returned.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-datasources",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 190
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "access": {
                  "enum": [
                    "proxy",
                    "direct"
                  ]
                },
                "is_default": {
                  "type": "boolean"
                }
              },
              "required": [
                "uid",
                "name",
                "type",
                "access",
                "is_default"
              ],
              "additionalProperties": false
            }
          },
          "complete": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "null"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:datasources"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "items",
          "complete",
          "next_cursor",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  ]
}
