{
  "kind": "connectors.adapter/v1",
  "id": "grafana",
  "version": "0.1.0",
  "sources": [
    "https://grafana.com/docs/grafana/latest/developers/http_api/data_source/",
    "https://grafana.com/docs/grafana-cloud/alerting-and-irm/irm/oncall/oncall-api-reference/alertgroups/",
    "https://github.com/grafana/incident-go/blob/21a0e7878e0217665ba90db8cf67f6edad306f50/client.gen.go"
  ],
  "configuration_schema": {
    "title": "effective local configuration",
    "description": "The document the adapter composition builds and validates at bootstrap, not the file an operator writes. The file (connectors_grafana.connection.LocalConfiguration in spec/ess) carries ca_file; this resolved form reduces the CA to ca_digest and carries the canonical base_url, and the canonical irm_api_url only when the file names one. See adapters/grafana/README.md.",
    "type": "object",
    "properties": {
      "format": {
        "const": "connectors-grafana-local/1"
      },
      "instance": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "base_url": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "ca_digest": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{64}$"
      },
      "irm_api_url": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      }
    },
    "required": [
      "format",
      "instance",
      "base_url",
      "ca_digest"
    ],
    "additionalProperties": false
  },
  "operations": [
    {
      "id": "datasources.list",
      "description": "List the data sources the service account can read: uid, name, plugin type, access mode and whether it is the default. One GET /api/datasources; unpaged, at most 1,000 records. Backend URLs, credentials and settings are never returned.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-datasources",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 190
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "access": {
                  "enum": [
                    "proxy",
                    "direct"
                  ]
                },
                "is_default": {
                  "type": "boolean"
                }
              },
              "required": [
                "uid",
                "name",
                "type",
                "access",
                "is_default"
              ],
              "additionalProperties": false
            }
          },
          "complete": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "null"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:datasources"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "items",
          "complete",
          "next_cursor",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "irm.alert_groups.list",
      "description": "List the IRM alert groups started in [since, until] (UTC, whole seconds), one page of at most 100. One GET api/v1/alert_groups/ on the IRM API URL with started_at, perpage and page; next_cursor is the next page of the same window. Store until and pass it back as the next run's since; deduplicate by id. Needs irm_api_url in the configuration and a grafana.irm_service_account connection. Read only.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-irm-alert-groups",
      "input_schema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "cursor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,5}$"
          },
          "state": {
            "enum": [
              "new",
              "acknowledged",
              "resolved",
              "silenced"
            ]
          },
          "integration_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,64}$"
          },
          "team_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,64}$"
          }
        },
        "required": [
          "since",
          "until"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/alert_group"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[1-9][0-9]{0,5}$"
          },
          "window": {
            "$ref": "#/$defs/window"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": [
          "items",
          "complete",
          "next_cursor",
          "window",
          "provenance"
        ],
        "additionalProperties": false,
        "$defs": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,64}$"
          },
          "alert_group": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "integration_id": {
                "$ref": "#/$defs/id"
              },
              "route_id": {
                "$ref": "#/$defs/id"
              },
              "alert_group_number": {
                "type": "integer",
                "minimum": 0
              },
              "alerts_count": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "new",
                  "acknowledged",
                  "resolved",
                  "silenced"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "created_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "acknowledged_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "resolved_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "silenced_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "root_alert_group_id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "id",
              "integration_id",
              "alerts_count",
              "state",
              "created_at"
            ],
            "additionalProperties": false
          },
          "window": {
            "type": "object",
            "properties": {
              "since": {
                "type": "string"
              },
              "until": {
                "type": "string"
              }
            },
            "required": [
              "since",
              "until"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:irm.alert_groups"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "irm.alert_group.get",
      "description": "Read one IRM alert group by id, to re-read the state of a group copied earlier (acknowledged_at, resolved_at, silenced_at). One GET api/v1/alert_groups/<id> on the IRM API URL. Needs irm_api_url and a grafana.irm_service_account connection. Read only.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-irm-alert-groups",
      "input_schema": {
        "type": "object",
        "properties": {
          "alert_group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,64}$"
          }
        },
        "required": [
          "alert_group_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/$defs/alert_group"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": [
          "item",
          "provenance"
        ],
        "additionalProperties": false,
        "$defs": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,64}$"
          },
          "alert_group": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "integration_id": {
                "$ref": "#/$defs/id"
              },
              "route_id": {
                "$ref": "#/$defs/id"
              },
              "alert_group_number": {
                "type": "integer",
                "minimum": 0
              },
              "alerts_count": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "new",
                  "acknowledged",
                  "resolved",
                  "silenced"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "created_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "acknowledged_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "resolved_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "silenced_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "root_alert_group_id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "id",
              "integration_id",
              "alerts_count",
              "state",
              "created_at"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:irm.alert_group"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "irm.incidents.list",
      "description": "List the IRM incidents created in [since, until] (UTC, whole seconds), one page of at most 50, with each incident's references to alert groups (links). One POST of IncidentsService.QueryIncidents to the stack's IRM plugin resource, a read; next_cursor is the next page of the same window. Store until and pass it back as the next run's since; deduplicate by incident_id. Needs irm_api_url and a grafana.irm_service_account connection. Read only.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-irm-incidents",
      "input_schema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "cursor": {
            "type": "string",
            "pattern": "^[!-~]{1,1024}$"
          }
        },
        "required": [
          "since",
          "until"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/incident"
            }
          },
          "links": {
            "type": "array",
            "maxItems": 3200,
            "items": {
              "$ref": "#/$defs/link"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[!-~]{1,1024}$"
          },
          "window": {
            "type": "object",
            "properties": {
              "since": {
                "type": "string"
              },
              "until": {
                "type": "string"
              }
            },
            "required": [
              "since",
              "until"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": [
          "items",
          "links",
          "complete",
          "next_cursor",
          "window",
          "provenance"
        ],
        "additionalProperties": false,
        "$defs": {
          "incident": {
            "type": "object",
            "properties": {
              "incident_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "status": {
                "enum": [
                  "active",
                  "resolved"
                ]
              },
              "severity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "is_drill": {
                "type": "boolean"
              },
              "created_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "modified_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "closed_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              }
            },
            "required": [
              "incident_id",
              "title",
              "status",
              "is_drill",
              "created_time",
              "modified_time"
            ],
            "additionalProperties": false
          },
          "link": {
            "type": "object",
            "properties": {
              "incident_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "alert_group_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,64}$"
              }
            },
            "required": [
              "incident_id",
              "alert_group_id"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:irm.incidents"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "irm.incident.get",
      "description": "Read one IRM incident by id, with its references to alert groups (links), to re-read status, modified_time and closed_time of an incident copied earlier. One POST of IncidentsService.GetIncident to the stack's IRM plugin resource, a read. Needs irm_api_url and a grafana.irm_service_account connection. Read only.",
      "contract": "datasource.records/v1alpha1",
      "profile": "grafana-irm-incidents",
      "input_schema": {
        "type": "object",
        "properties": {
          "incident_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        },
        "required": [
          "incident_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/$defs/incident"
          },
          "links": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/link"
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": [
          "item",
          "links",
          "provenance"
        ],
        "additionalProperties": false,
        "$defs": {
          "incident": {
            "type": "object",
            "properties": {
              "incident_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "status": {
                "enum": [
                  "active",
                  "resolved"
                ]
              },
              "severity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "is_drill": {
                "type": "boolean"
              },
              "created_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "modified_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              },
              "closed_time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40
              }
            },
            "required": [
              "incident_id",
              "title",
              "status",
              "is_drill",
              "created_time",
              "modified_time"
            ],
            "additionalProperties": false
          },
          "link": {
            "type": "object",
            "properties": {
              "incident_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "alert_group_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,64}$"
              }
            },
            "required": [
              "incident_id",
              "alert_group_id"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string"
              },
              "resource": {
                "const": "grafana:irm.incident"
              },
              "observed_at_unix_ms": {
                "type": "integer"
              },
              "source_revision": {
                "type": "null"
              }
            },
            "required": [
              "instance",
              "resource",
              "observed_at_unix_ms",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
