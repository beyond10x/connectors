          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resource": {
                "type": "string"
              },
