              "deployments",
              "endpointslices"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
