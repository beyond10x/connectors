{
  "kind": "connectors.adapter/v1",
  "id": "kubernetes",
  "version": "0.1.0",
  "sources": [
    "https://kubernetes.io/docs/reference/using-api/api-concepts/",
    "https://kubernetes.io/docs/concepts/services-networking/endpoint-slices/",
    "https://kubernetes.io/docs/reference/kubernetes-api/cluster-resources/node-v1/",
    "https://raw.githubusercontent.com/helm/helm/bec5b06ed841fe5269972d864d5177944fd5970f/pkg/storage/driver/secrets.go",
    "https://raw.githubusercontent.com/helm/helm/144ca65f8501953fa8b41cd1d37c7223051c85b7/pkg/storage/driver/secrets.go"
  ],
  "configuration_schema": {
    "oneOf": [
      {
        "title": "effective local configuration",
        "description": "The document the adapter composition builds and validates at bootstrap, not the file an operator writes. The file carries ca_file and may omit discover_hosts; this schema describes the resolved form, in which the CA is reduced to ca_digest and discover_hosts is always present. See docs/local-kubernetes-cli.md for the on-disk format.",
        "type": "object",
        "properties": {
          "format": {
            "const": "connectors-kubernetes-local/1"
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "api_base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https://.+/$"
          },
          "ca_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            }
          },
          "resource_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "pods",
                "services",
                "deployments",
                "endpointslices"
              ]
            }
          },
          "discover_hosts": {
            "type": "boolean"
          },
          "helm_release_reads": {
            "description": "Helm release reads. off advertises none. metadata advertises revision history and deployed status, read from release-Secret metadata only. redacted_content additionally advertises the recorded values and rendered manifest as safe projections that never carry a stored literal. There is no setting that discloses provider bytes.",
            "enum": [
              "off",
              "metadata",
              "redacted_content"
            ]
          }
        },
        "required": [
          "format",
          "instance",
          "api_base",
          "ca_digest",
          "namespaces",
          "resource_kinds",
          "discover_hosts",
          "helm_release_reads"
        ],
        "additionalProperties": false
      },
      {
        "title": "federated service configuration",
        "description": "The on-disk document read by --config in the federated service mode.",
        "type": "object",
        "properties": {
          "service": {
            "$ref": "urn:connectors:config:v1:service"
          },
          "http": {
            "$ref": "urn:connectors:config:v1:http"
          },
          "adapter": {
            "type": "object",
            "properties": {
              "namespaces": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                }
              },
              "resource_kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "pods",
                    "services",
                    "deployments",
                    "endpointslices"
                  ]
                }
              },
              "discover_hosts": {
                "type": "boolean"
              },
              "helm_release_reads": {
                "description": "Helm release reads. off advertises none. metadata advertises revision history and deployed status, read from release-Secret metadata only. redacted_content additionally advertises the recorded values and rendered manifest as safe projections that never carry a stored literal. There is no setting that discloses provider bytes.",
                "enum": [
                  "off",
                  "metadata",
                  "redacted_content"
                ]
              }
            },
            "required": [
              "namespaces",
              "resource_kinds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "service",
          "http",
          "adapter"
        ],
        "additionalProperties": false
      }
    ]
  },
  "operations": [
    {
      "id": "resources.list",
