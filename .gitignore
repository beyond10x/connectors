# safety net: key material never enters this repo
*.pem
*.key

/target/
node_modules/
.DS_Store

# Generated site output (design 02 §1: "sources; generated output not committed twice").
# A build rewrites `web/public/catalog.json` from `catalog/`, so committing it would store the same
# facts twice and make every catalogue change a two-place diff.
/web/public/catalog.json
/web/.vitepress/dist/
/web/.vitepress/cache/
