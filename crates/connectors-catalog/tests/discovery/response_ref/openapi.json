{
  "openapi": "3.0.3",
  "info": {"title": "Fixture API", "version": "v1"},
  "servers": [{"url": "https://fixture.googleapis.com/fixture/v1"}],
  "paths": {
    "/things": {
      "get": {
        "operationId": "fixture.things.list",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ThingList"}}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "properties": {"name": {"type": "string"}}
      },
      "ThingList": {
        "type": "object",
        "properties": {
          "nextPageToken": {"type": "string"},
          "things": {"type": "array", "items": {"$ref": "#/components/schemas/Thing"}}
        }
      }
    }
  }
}
