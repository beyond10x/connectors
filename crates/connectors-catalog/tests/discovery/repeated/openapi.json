{
  "openapi": "3.0.3",
  "info": {"title": "Fixture API", "version": "v1"},
  "servers": [{"url": "https://fixture.googleapis.com/fixture/v1"}],
  "paths": {
    "/things": {
      "get": {
        "operationId": "fixture.things.list",
        "parameters": [
          {
            "name": "eventTypes",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["default", "focusTime"],
                "x-google-enum-descriptions": ["Regular events.", "Focus time."]
              }
            }
          },
          {
            "name": "labelIds",
            "in": "query",
            "description": "Only things with every label.",
            "style": "form",
            "explode": true,
            "schema": {"type": "array", "items": {"type": "string"}}
          }
        ],
        "responses": {"200": {"description": "Successful response"}}
      }
    }
  }
}
