      "200",
      "400",
      "500"
    ],
    "parameters": [
      "all",
      "limit",
      "size",
      "filters"
    ]
  },
  "/images/json": {
    "method": "get",
    "operation_id": "ImageList",
    "response_codes": [
      "200",
      "500"
    ],
    "parameters": [
      "all",
      "filters",
      "shared-size",
      "digests",
      "manifests",
      "identity"
    ]
  },
  "/volumes": {
    "method": "get",
    "operation_id": "VolumeList",
    "response_codes": [
      "200",
      "500"
    ],
    "parameters": [
      "filters"
    ]
  },
  "/networks": {
    "method": "get",
    "operation_id": "NetworkList",
    "response_codes": [
      "200",
      "500"
    ],
    "parameters": [
      "filters"
    ]
  },
  "/containers/{id}/json": {
    "method": "get",
    "operation_id": "ContainerInspect",
    "response_codes": [
      "200",
      "404",
      "500"
    ],
    "parameters": [
      "id",
      "size"
    ]
  },
  "/containers/{id}/logs": {
    "method": "get",
