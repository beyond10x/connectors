      "304",
      "404",
      "500"
    ],
    "parameters": [
      "id",
      "signal",
      "t"
    ]
  },
  "/containers/{id}/restart": {
    "method": "post",
    "operation_id": "ContainerRestart",
    "response_codes": [
      "204",
      "404",
      "500"
    ],
    "parameters": [
      "id",
      "signal",
      "t"
    ]
  }
