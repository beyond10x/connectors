{
  "kind": "ephemeral independent declaration/trace audit",
  "runtime_execution": false,
  "checks": [
    "guarded outcome against declared transitions",
    "wrong-state expected state",
    "final view state",
    "supplied lease <= 2 seconds",
    "accepted cutoff <= existing lease expiry and terminal + 2 seconds",
    "teardown <= first accepted terminal + 5 seconds"
  ],
  "scenarios": [
    {
      "scenario": "continuity-loss-stays-lost",
      "steps": 6,
      "final_state": "Lost",
      "trace": [
        {
          "command": "OfferSession",
          "outcome": "offered",
          "state_after": "Offered"
        },
        {
          "command": "AcceptOffer",
          "outcome": "accepted",
          "state_after": "Establishing"
        },
        {
          "command": "EstablishReady",
          "outcome": "ready",
          "state_after": "Ready"
        },
        {
          "command": "LoseContinuity",
          "outcome": "lost",
          "state_after": "Lost"
        },
        {
          "command": "RenewDataLease",
          "outcome": "wrong-state",
          "state_after": "Lost"
        },
        {
          "command": "PermitData",
          "outcome": "wrong-state",
          "state_after": "Lost"
        }
      ]
