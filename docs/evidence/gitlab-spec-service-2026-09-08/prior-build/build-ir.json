{
  "format": "ess-build-ir/1",
  "build": "gitlab-local",
  "platforms": [
    {
      "os": "linux",
      "architecture": "amd64"
    }
  ],
  "nodes": {
    "payload": {
      "kind": "source",
      "path": "rootfs",
      "destination": "/"
    },
    "service": {
      "kind": "image",
      "rootfs": "payload",
      "config": {
        "entrypoint": [
          "/usr/local/bin/connectors-gitlab"
        ],
        "command": [
          "--config",
          "/config/service.json"
        ],
        "user": "65532:65532",
        "workdir": "/",
        "environment": {
          "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
        }
      }
    }
  },
  "order": [
    "payload",
    "service"
  ],
  "outputs": {
    "gitlab": {
      "name": "gitlab",
      "release_unit": "connectors-gitlab",
      "node": "service",
      "kind": "oci_image",
      "repository": "connectors-v2-gitlab"
    }
  }
}
