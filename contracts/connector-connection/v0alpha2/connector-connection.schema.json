        "connection_ref": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
          "type": "string"
        },
        "initiation": {
          "items": {
            "$ref": "#/$defs/ConnectionInitiator"
