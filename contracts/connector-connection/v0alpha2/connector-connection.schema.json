          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "integration_ref": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
