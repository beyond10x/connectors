        {
          "properties": {
            "connection_ref": {
              "type": "null"
            },
            "state": {
              "const": "pending"
            }
          }
        },
        {
          "properties": {
            "browser_completion_url": {
              "type": "null"
            },
            "completion_endpoint": {
              "type": "null"
            },
            "connection_ref": {
              "not": {
                "type": "null"
              }
            },
            "state": {
              "const": "completed"
            }
          },
          "required": [
            "connection_ref"
          ]
        },
        {
          "properties": {
            "browser_completion_url": {
              "type": "null"
            },
            "completion_endpoint": {
              "type": "null"
            },
            "connection_ref": {
              "type": "null"
            },
            "state": {
              "const": "expired"
            }
          }
        },
        {
          "properties": {
            "browser_completion_url": {
              "type": "null"
            },
            "completion_endpoint": {
              "type": "null"
            },
            "connection_ref": {
              "type": "null"
            },
            "state": {
              "const": "failed"
            }
          }
        }
      ],
      "properties": {
        "browser_completion_url": {
          "anyOf": [
            {
              "$comment": "Legacy WHATWG parse, route and fragment-capability checks are enforced by the inherited v1 reader.",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_endpoint": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[^\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connect_session_ref": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
          "type": "string"
        },
        "connection_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at_unix_ms": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
