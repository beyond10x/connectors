{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beyond10x/connectors/blob/main/contracts/connector-connection/v0alpha1/connector-connection.schema.json",
  "title": "B10x ConnectorConnection v0alpha1 frame",
  "oneOf": [
    {"$ref":"#/$defs/request_envelope"},
    {"$ref":"#/$defs/response_envelope"}
  ],
  "$defs": {
    "ref": {"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\s\\u0000-\\u001f\\u007f]+$"},
    "owner": {
      "type":"object","additionalProperties":false,
      "required":["tenant_id","agent_id","agent_revision","authority_snapshot_id","authority_snapshot_sha256"],
      "properties": {
        "tenant_id":{"$ref":"#/$defs/ref"},"agent_id":{"$ref":"#/$defs/ref"},
        "agent_revision":{"type":"integer","minimum":1},"authority_snapshot_id":{"$ref":"#/$defs/ref"},
        "authority_snapshot_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"}
      }
    },
    "request_envelope": {
      "type":"object","additionalProperties":false,"required":["protocol","request_id","context","request"],
      "properties": {
        "protocol":{"const":"b10x.connector-connection.v0alpha1"},
        "request_id":{"type":"string","minLength":1,"maxLength":128},
        "context":{"$ref":"#/$defs/owner"},"request":{"$ref":"#/$defs/request"}
      }
    },
    "request": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"candidate_search"},"params":{"type":"object","additionalProperties":false,"required":["integration_ref","query","limit"],"properties":{"integration_ref":{"$ref":"#/$defs/ref"},"query":{"type":"string","maxLength":512},"limit":{"type":"integer","minimum":1,"maximum":64}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"candidate_activate"},"params":{"type":"object","additionalProperties":false,"required":["candidate_ref","label"],"properties":{"candidate_ref":{"$ref":"#/$defs/ref"},"label":{"type":"string","minLength":1,"maxLength":256}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"search"},"params":{"type":"object","additionalProperties":false,"required":["query","limit"],"properties":{"query":{"type":"string","maxLength":512},"limit":{"type":"integer","minimum":1,"maximum":64}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"describe"},"params":{"type":"object","additionalProperties":false,"required":["connection_ref"],"properties":{"connection_ref":{"$ref":"#/$defs/ref"}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"observation_search"},"params":{"type":"object","additionalProperties":false,"required":["source_connection_ref","query","limit"],"properties":{"source_connection_ref":{"$ref":"#/$defs/ref"},"query":{"type":"string","maxLength":512},"limit":{"type":"integer","minimum":1,"maximum":64}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"materialize"},"params":{"type":"object","additionalProperties":false,"required":["observation_ref"],"properties":{"observation_ref":{"$ref":"#/$defs/ref"}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"connect_session_create"},"params":{"type":"object","additionalProperties":false,"required":["integration_ref","label"],"properties":{"integration_ref":{"$ref":"#/$defs/ref"},"label":{"type":"string","minLength":1,"maxLength":256},"auth_profile":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9._-]+$"}}}}},
        {"type":"object","additionalProperties":false,"required":["method","params"],"properties":{"method":{"const":"connect_session_status"},"params":{"type":"object","additionalProperties":false,"required":["connect_session_ref"],"properties":{"connect_session_ref":{"$ref":"#/$defs/ref"}}}}}
      ]
    },
    "response_envelope": {
      "type":"object","additionalProperties":false,"required":["protocol","request_id","status"],
      "properties": {
        "protocol":{"const":"b10x.connector-connection.v0alpha1"},"request_id":{"type":"string","minLength":1,"maxLength":128},
        "status":{"enum":["ok","error"]},"response":{"$ref":"#/$defs/result"},"error":{"$ref":"#/$defs/error"}
      },
      "oneOf":[{"required":["response"],"not":{"required":["error"]}},{"required":["error"],"not":{"required":["response"]}}]
    },
    "connection_route": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"direct"}}},
        {"type":"object","additionalProperties":false,"required":["kind","parent_connection_ref","route_adapter"],"properties":{"kind":{"const":"via_connection"},"parent_connection_ref":{"$ref":"#/$defs/ref"},"route_adapter":{"enum":["grafana_datasource_proxy_v1","kubernetes_service_proxy_v1"]}}}
      ]
    },
    "connection_summary": {
      "type":"object","additionalProperties":false,
      "dependentRequired":{"scope":["actor"],"actor":["scope"]},
      "required":["connection_ref","integration_ref","label","state","initiation","route"],
      "properties": {
        "connection_ref":{"$ref":"#/$defs/ref"},"integration_ref":{"$ref":"#/$defs/ref"},
        "label":{"type":"string","minLength":1,"maxLength":256},
        "state":{"enum":["created","authorized","callable","degraded","revoked"]},
        "initiation":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["b10x","provider"]}},
        "route":{"$ref":"#/$defs/connection_route"},
        "scope":{"enum":["tenant","principal"]},
        "actor":{"enum":["app","user"]},
        "auth_profile":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9._-]+$"}
      }
    },
    "channel_summary": {
      "type":"object","additionalProperties":false,
      "required":["channel_ref","binding_ref","state","events"],
      "properties": {
        "channel_ref":{"$ref":"#/$defs/ref"},"binding_ref":{"$ref":"#/$defs/ref"},
        "state":{"enum":["starting","connected","reconnecting","stopped"]},
        "events":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/ref"}}
      }
    },
    "connection_description": {
      "type":"object","additionalProperties":false,
      "dependentRequired":{"scope":["actor"],"actor":["scope"]},
      "required":["connection_ref","integration_ref","label","state","initiation","route","channels"],
      "properties": {
        "connection_ref":{"$ref":"#/$defs/ref"},"integration_ref":{"$ref":"#/$defs/ref"},
        "label":{"type":"string","minLength":1,"maxLength":256},
        "state":{"enum":["created","authorized","callable","degraded","revoked"]},
        "initiation":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["b10x","provider"]}},
        "route":{"$ref":"#/$defs/connection_route"},
        "scope":{"enum":["tenant","principal"]},
        "actor":{"enum":["app","user"]},
        "auth_profile":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9._-]+$"},
        "channels":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/channel_summary"}}
      }
    },
    "connect_session_status": {
      "type":"object","additionalProperties":false,
      "required":["connect_session_ref","integration_ref","state","expires_at_unix_ms"],
      "properties": {
        "connect_session_ref":{"$ref":"#/$defs/ref"},"integration_ref":{"$ref":"#/$defs/ref"},
        "state":{"enum":["pending","completed","expired","failed"]},
        "expires_at_unix_ms":{"type":"integer","minimum":0},
        "completion_endpoint":{"type":"string","minLength":1,"maxLength":4096},
        "browser_completion_url":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(http://127\\.0\\.0\\.1:[0-9]+/|https://[^/\\s]+/)[^\\s]*$"},
        "connection_ref":{"$ref":"#/$defs/ref"}
      }
    },
    "connection_candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_ref","integration_ref","title","state","evidence_sha256"],
      "properties": {
        "candidate_ref":{"$ref":"#/$defs/ref"},"integration_ref":{"$ref":"#/$defs/ref"},
        "title":{"type":"string","minLength":1,"maxLength":256},
        "state":{"enum":["detected","activated"]},
        "evidence_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
        "connection_ref":{"$ref":"#/$defs/ref"}
      }
    },
    "discovery_observation": {
      "type":"object","additionalProperties":false,
      "required":["observation_ref","discovery_ref","source_connection_ref","observed_type","title","state","evidence_generation","evidence_sha256"],
      "properties": {
        "observation_ref":{"$ref":"#/$defs/ref"},"discovery_ref":{"$ref":"#/$defs/ref"},
        "source_connection_ref":{"$ref":"#/$defs/ref"},
        "observed_type":{"type":"string","minLength":1,"maxLength":128},
        "title":{"type":"string","minLength":1,"maxLength":256},
        "state":{"enum":["observed","unsupported","materialized","withdrawn"]},
        "evidence_generation":{"type":"integer","minimum":1},
        "evidence_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
        "target_provider_ref":{"$ref":"#/$defs/ref"},"connection_ref":{"$ref":"#/$defs/ref"}
      }
    },
    "result": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"candidate_search"},"value":{"type":"object","additionalProperties":false,"required":["candidates"],"properties":{"candidates":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/connection_candidate"}}}}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"candidate_activate"},"value":{"$ref":"#/$defs/connection_description"}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"search"},"value":{"type":"object","additionalProperties":false,"required":["connections"],"properties":{"connections":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/connection_summary"}}}}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"describe"},"value":{"$ref":"#/$defs/connection_description"}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"observation_search"},"value":{"type":"object","additionalProperties":false,"required":["observations"],"properties":{"observations":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/discovery_observation"}}}}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"const":"materialize"},"value":{"$ref":"#/$defs/connection_description"}}},
        {"type":"object","additionalProperties":false,"required":["result","value"],"properties":{"result":{"enum":["connect_session_create","connect_session_status"]},"value":{"$ref":"#/$defs/connect_session_status"}}}
      ]
    },
    "error": {
      "type":"object","additionalProperties":false,"required":["code","message","retriable"],
      "properties":{"code":{"enum":["unavailable","not_found","not_granted","invalid_input","stale_authority","conflict","protocol"]},"message":{"type":"string","minLength":1,"maxLength":4096},"retriable":{"type":"boolean"}}
    }
  }
}
