{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b10x/connectors/blob/main/contracts/artifact-bundle.schema.json",
  "title": "B10x immutable contract or binding bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle", "version", "stability", "files"],
  "properties": {
    "bundle": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "stability": { "enum": ["alpha", "stable"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9./_-]*$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
