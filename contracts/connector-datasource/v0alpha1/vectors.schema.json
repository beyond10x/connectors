{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beyond10x/b10x/blob/main/foundation/connectors/contracts/connector-datasource/v0alpha1/vectors.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": {"const": "b10x.connector-datasource.v0alpha1"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "valid", "frame"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "valid": {"type": "boolean"},
          "frame": {"type": "object"}
        }
      }
    }
  }
}
