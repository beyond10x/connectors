{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b10x.dev/contracts/connector-operation/v0alpha1/vectors.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": {"const": "b10x.connector-operation.v0alpha1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "valid", "frame"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "valid": {"type": "boolean"},
          "frame": true
        }
      }
    }
  }
}
