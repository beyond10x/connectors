{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connectors-owned adapter specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "sources", "configuration_schema", "operations"],
  "properties": {
    "kind": {"const": "connectors.adapter/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://"}},
    "configuration_schema": {"type": "object"},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "contract", "profile", "input_schema", "output_schema"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
          "description": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "profile": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"}
        }
      }
    }
  }
}
