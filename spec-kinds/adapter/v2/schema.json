{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connectors-owned adapter specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "version",
    "sources",
    "configuration_schema",
    "operations",
    "upstream",
    "mappings"
  ],
  "properties": {
    "kind": {
      "const": "connectors.adapter/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "configuration_schema": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "contract",
          "profile",
          "input_schema",
          "output_schema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "revision",
        "sha256",
        "base_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_path": {
          "type": "string",
          "pattern": "^/[^?#]*[^/]$"
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "upstream_operation",
          "path",
          "method",
          "path_parameters",
          "query_parameters",
          "obligations"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "upstream_operation": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "method": {
            "const": "get"
          },
          "path_parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "input"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "binding"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "const": "constant"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "query_parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "input"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "binding"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "const": "constant"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "response_prefix_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "obligations": {
            "const": [
              "prepare",
              "finish"
            ]
          }
        }
      }
    }
  }
}
